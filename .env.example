# ============================================================
# Contract signing flow. Copy to .env for local work, and set the
# same values in Netlify (Site configuration -> Environment variables).
# See docs/CONTRACT.md for the full runbook.
# ============================================================

# HMAC key for the per-couple contract links. 32+ bytes of hex.
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# In Netlify, scope it to Functions only and mark it secret:
#   netlify env:set CONTRACT_LINK_SECRET <value> --secret --scope functions
CONTRACT_LINK_SECRET=

# Optional. During a secret rotation, the OLD key goes here so links already
# sent to couples keep working until they expire.
CONTRACT_LINK_SECRET_PREV=

# The password for /admin - the page where Yariv mints contract links and sees
# the list of the ones already sent. 12 characters minimum; shorter (or empty)
# and admin-login refuses to let anyone in rather than falling back to a default.
# In Netlify, scope it to Functions only and mark it secret. A secret value
# needs an explicit --context, so plain `env:set --secret` fails:
#   netlify env:set CONTRACT_ADMIN_PASSWORD <value> --secret --scope functions \
#     --context production deploy-preview branch-deploy
# Never commit a real value here - this file is tracked, .env is not.
CONTRACT_ADMIN_PASSWORD=

# Resend API key (free tier is plenty - two emails per signed contract).
RESEND_API_KEY=

# test = both copies go to CONTRACT_NOTIFY_EMAIL, and the couple's copy carries
#        a visible banner saying where it should have gone. Use this until the
#        sending domain is verified - Resend will only deliver to the account
#        owner before then, and this makes that explicit instead of silent.
# live = real recipients.
CONTRACT_MAIL_MODE=test

# Before domain verification this must stay onboarding@resend.dev.
# After: Brothers Photography <contracts@send.brothers-photography.com>
CONTRACT_MAIL_FROM=Brothers Photography <onboarding@resend.dev>

# Where the photographer's copy goes, and the Reply-To on the couple's copy.
CONTRACT_NOTIFY_EMAIL=yariv70@gmail.com
