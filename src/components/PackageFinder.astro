  @media (prefers-reduced-motion: reduce) {
    .finder.is-updating [data-r-name],
    .finder.is-updating [data-r-tag],
    .finder.is-updating [data-r-guests],
    .finder.is-updating [data-r-includes],
    .finder.is-updating [data-r-addons],
    .finder.is-updating [data-r-price] { opacity: 1; }
  }
</style>

<script
  is:inline
  define:vars={{ f, defaults, guestsStep, whatsapp: site.contact.whatsapp, lead, pages }}
>
  (() => {
    const section = document.querySelector(".finder");
    const root = document.querySelector("[data-finder]");
    if (!root) return;

    const state = {
      guests: defaults.guests, // numeric guest count
      coverage: defaults.coverage,
      extras: [...defaults.extras],
      discount: defaults.discount,
      names: defaults.names,
      date: defaults.date,
    };

    // Map a numeric guest count to a package tier.
    const tierForGuests = (n) => {
      const [t1, t2] = guestsStep.thresholds;
      const [b, c, p] = guestsStep.tiers;
      return n <= t1 ? b : n <= t2 ? c : p;
    };

    const check = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

    // Result nodes
    const nName = root.querySelector("[data-r-name]");
    const nTag = root.querySelector("[data-r-tag]");
    const nGuests = root.querySelector("[data-r-guests]");
    const nIncludes = root.querySelector("[data-r-includes]");
    const nAddons = root.querySelector("[data-r-addons]");
    const nChips = root.querySelector("[data-r-chips]");
    const nWa = root.querySelector("[data-r-wa]"); // /lp/* only
    const nLivePkg = root.querySelector("[data-live-pkg]"); // lead only
    const nLivePrice = root.querySelector("[data-live-price]");
    const nPriceNow = root.querySelector("[data-r-price-now]");
    const nPriceWas = root.querySelector("[data-r-price-was]");
    const nDiscount = root.querySelector("[data-r-discount]");
    const nCouple = root.querySelector("[data-r-couple]");
    const nContinue = root.querySelector("[data-r-continue]");

    // Mirrors priceFor / formatPrice in the frontmatter.
    const priceFor = (pkg) =>
      pkg.priceStills +
      (state.coverage === "video" ? pkg.priceVideoAdd : 0) +
      state.extras.reduce((sum, id) => sum + (f.addons[id]?.price ?? 0), 0);
    // Only extras that still exist in site.finder.addons are shown or sent.
    const extraNamesFor = () =>
      state.extras.map((id) => f.addons[id]?.name).filter(Boolean);
    const formatPrice = (n) =>
      `${f.result.priceFrom}${n.toLocaleString("en-US")} ${f.result.currency}`;
    const formatMoney = (n) => `${n.toLocaleString("en-US")} ${f.result.currency}`;
    const readoutFor = (n) =>
      n >= guestsStep.max ? guestsStep.maxLabel : `${n} ${guestsStep.unit}`;
    // yyyy-mm-dd -> dd.mm.yyyy
    const formatDate = (d) => (d ? d.split("-").reverse().join(".") : "");

    // The selection is handed to the lead forms (LeadFunnel) through
    // sessionStorage + a window event. Only saved once the visitor has actually
    // interacted, so an untouched default is never reported as "their choice".
    let touched = false;
    let current = null;
    const campaign = location.pathname.startsWith("/lp/")
      ? location.pathname.split("/")[2]
      : "homepage";
    const save = () => {
      if (!touched || !current) return;
      try {
        sessionStorage.setItem("brothers:selection", JSON.stringify(current));
      } catch {}
      window.dispatchEvent(new CustomEvent("brothers:selection", { detail: current }));
    };

    const render = () => {
      const pkg = f.packages[tierForGuests(state.guests)] || f.packages.classic;
      const includes = [...pkg.stills];
      if (state.coverage === "video") includes.push(...pkg.video);
      includes.push(...f.common);

      nName.textContent = pkg.name;
      nTag.textContent = pkg.tag;
      nGuests.textContent = pkg.guests;
      nIncludes.innerHTML = includes
        .map((t) => `<li>${check}<span>${t}</span></li>`)
        .join("");

      // Extras
      const extraNames = extraNamesFor();
      if (extraNames.length) {
        nChips.innerHTML = extraNames
          .map((name) => `<span class="chip">${name}</span>`)
          .join("");
        nAddons.hidden = false;
      } else {
        nAddons.hidden = true;
        nChips.innerHTML = "";
      }

      // Price (after the reserve-duty / student discount, if any)
      const fullPrice = priceFor(pkg);
      const disc = f.discounts[state.discount];
      const saved = disc ? Math.round(fullPrice * disc.rate) : 0;
      const price = fullPrice - saved;
      const priceText = formatPrice(price);
      nPriceNow.textContent = priceText;
      nPriceWas.hidden = !disc;
      nPriceWas.textContent = disc ? formatPrice(fullPrice) : "";
      nDiscount.hidden = !disc;
      nDiscount.textContent = disc
        ? f.result.discountNote
            .replace("{name}", disc.name)
            .replace("{pct}", String(Math.round(disc.rate * 100)))
            .replace("{saved}", formatMoney(saved))
        : "";
      const discountText = disc
        ? `${disc.name} (${Math.round(disc.rate * 100)}%)`
        : "";

      // Couple + date line in the banner
      const names = state.names.trim();
      const dateText = formatDate(state.date);
      const couple = [names, dateText].filter(Boolean).join(" · ");
      nCouple.hidden = !couple;
      nCouple.textContent = couple;

      // WhatsApp deep link
      const coverageLabel =
        state.coverage === "video"
          ? f.result.coverageVideo
          : f.result.coverageStills;
      const extrasText = extraNames.length
        ? f.result.extrasPrefix + extraNames.join(", ")
        : "";
      const msg = f.result.whatsappText
        .replace("{names}", names ? f.result.namesPrefix + names : "")
        .replace("{pkg}", pkg.name)
        .replace("{coverage}", coverageLabel)
        .replace("{extras}", extrasText)
        .replace("{discount}", discountText ? f.result.discountPrefix + discountText : "")
        .replace("{guests}", readoutFor(state.guests))
        .replace("{price}", priceText)
        .replace("{date}", dateText);
      nWa?.setAttribute(
        "href",
        `https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`
      );
      if (nLivePkg) {
        nLivePkg.textContent = pkg.name;
        nLivePrice.textContent = priceText;
      }

      current = {
        pkgName: pkg.name,
        coverage: coverageLabel,
        extras: extraNames,
        guests: state.guests,
        guestsText: readoutFor(state.guests),
        price,
        priceText,
        discount: discountText,
        names,
        date: state.date,
      };
      save();
    };

    const flash = () => {
      section.classList.add("is-updating");
      setTimeout(() => section.classList.remove("is-updating"), 180);
    };

    // Wire up the guest-count slider
    const slider = root.querySelector("[data-slider]");
    const readout = root.querySelector("[data-readout]");
    if (slider) {
      const min = Number(slider.min);
      const max = Number(slider.max);
      let lastTier = tierForGuests(state.guests);
      slider.addEventListener("input", () => {
        const val = Number(slider.value);
        state.guests = val;
        // Update readout + track fill on every tick (cheap).
        readout.textContent = readoutFor(val);
        slider.style.setProperty(
          "--fill",
          `${((val - min) / (max - min)) * 100}%`
        );
        // Only rebuild the panel when the recommended tier actually changes.
        const tier = tierForGuests(val);
        touched = true;
        if (tier !== lastTier) {
          lastTier = tier;
          flash();
        }
        // Always re-render: the WhatsApp text carries the exact guest count.
        render();
      });
    }

    // Wire up names + date (no flash: these don't change the recommendation)
    root.querySelectorAll("[data-detail]").forEach((input) => {
      const key = input.getAttribute("data-detail");
      const update = () => {
        state[key] = input.value;
        touched = true;
        render();
      };
      input.addEventListener("input", update);
      input.addEventListener("change", update);
    });

    // Wire up pills
    root.querySelectorAll(".pill").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.getAttribute("data-group");
        const val = btn.getAttribute("data-value");
        const id = btn.getAttribute("data-id");
        const group = btn.closest("[data-opts]");
        const multi = group.getAttribute("data-multi") === "1";
        touched = true;

        if (multi) {
          const i = state.extras.indexOf(id);
          if (i >= 0) state.extras.splice(i, 1);
          else state.extras.push(id);
          const on = state.extras.includes(id);
          btn.classList.toggle("is-selected", on);
          btn.setAttribute("aria-pressed", String(on));
        } else {
          if (state[key] === val) return;
          state[key] = val;
          group.querySelectorAll(".pill").forEach((b) => {
            const sel = b === btn;
            b.classList.toggle("is-selected", sel);
            b.setAttribute("aria-pressed", String(sel));
          });
        }
        flash();
        render();
      });
    });

    // Sending to WhatsApp or going to the form both count as choosing the
    // recommended package as-is. Tracked here and not in save(), which runs on
    // every slider tick.
    const choose = () => {
      touched = true;
      save();
      if (current) {
        window.lpTrackCustom?.("SelectPackage", {
          campaign,
          item_name: current.pkgName,
          coverage: current.coverage,
          guests: current.guests,
          value: current.price,
          currency: "ILS",
        });
      }
    };
    nWa?.addEventListener("click", choose);
    nContinue?.addEventListener("click", choose);

    render();
    if (!lead) return;

    // ================= Lead mode (homepage) =================
    // The card is the <form>. Submitting counts as choosing the package as-is;
    // this listener is registered before scripts/leadForm.js (a deferred
    // module), so the selection is saved by the time that one reads it.
    root.addEventListener("submit", choose);

    // Venue is required. A whitespace-only value doesn't count, and an empty
    // field gets a Hebrew message both inline and in the browser's bubble.
    const venueInput = root.querySelector("[data-lead-venue]");
    const venueError = root.querySelector("[data-venue-error]");
    const venueOk = () => {
      const ok = !!venueInput.value.trim();
      venueInput.setCustomValidity(ok ? "" : f.lead.venueError);
      return ok;
    };
    const showVenueError = (on) => {
      venueError.hidden = !on;
      if (on) venueInput.setAttribute("aria-invalid", "true");
      else venueInput.removeAttribute("aria-invalid");
    };
    if (venueInput && venueError) {
      venueOk();
      venueInput.addEventListener("invalid", () => showVenueError(true));
      venueInput.addEventListener("input", () => {
        if (venueOk()) showVenueError(false);
      });
    }

    // An Enter in the names/date step must not submit the whole form.
    root.querySelectorAll("[data-detail]").forEach((input) =>
      input.addEventListener("keydown", (e) => {
        if (e.key !== "Enter") return;
        e.preventDefault();
        if (stepper) go(page + 1);
      })
    );

    // First touch of any question = the couple started the funnel.
    let started = false;
    root.addEventListener("input", markStart, true);
    root.addEventListener("click", (e) => {
      if (e.target.closest(".pill, [data-next]")) markStart();
    }, true);
    function markStart() {
      if (started) return;
      started = true;
      window.lpTrackCustom?.("finder_start", { campaign });
    }

    // ---- Stepper: one page at a time on phones ----
    const mq = window.matchMedia("(max-width: 760px)");
    const pageEls = [...root.querySelectorAll("[data-page]")];
    const chrome = root.querySelector("[data-stepper]");
    const nav = root.querySelector("[data-step-nav]");
    const live = root.querySelector("[data-live]");
    const nextBtn = root.querySelector("[data-next]");
    const nextText = root.querySelector("[data-next-text]");
    const nameInput = root.querySelector("[data-lead-name]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let stepper = false;
    let page = 1;
    let advanceTimer = 0;

    const headerH = () =>
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) || 78;

    // Keep the card's top edge in view as pages swap, so the next question is
    // where the eye already is rather than somewhere above the fold.
    const keepInView = () => {
      const top = root.getBoundingClientRect().top - headerH() - 12;
      if (Math.abs(top) > 40) {
        window.scrollTo({ top: window.scrollY + top, behavior: reduced.matches ? "auto" : "smooth" });
      }
    };

    // Count the price up on the result page - the payoff of the quiz.
    const countUp = () => {
      if (reduced.matches || !current) return;
      const end = current.price;
      const t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / 700);
        const eased = 1 - Math.pow(1 - k, 3);
        nPriceNow.textContent = formatPrice(Math.round((end * eased) / 100) * 100);
        if (k < 1) requestAnimationFrame(tick);
        else nPriceNow.textContent = current.priceText;
      };
      requestAnimationFrame(tick);
    };

    const paint = () => {
      pageEls.forEach((el) => {
        const on = !stepper || Number(el.dataset.page) === page;
        el.classList.toggle("is-on", stepper && on);
        el.hidden = !on;
      });
      root.classList.toggle("is-result", stepper && page === pages);
      chrome.hidden = !stepper;
      nav.hidden = !stepper || page === pages;
      live.hidden = page < 2;
      chrome.querySelector("[data-step-now]").textContent = String(page);
      chrome.querySelector("[data-step-fill]").style.width = `${(page / pages) * 100}%`;
      chrome.querySelector("[data-back]").hidden = page === 1;
      nextText.textContent =
        page === pages - 1 ? nextBtn.dataset.lastLabel : nextBtn.dataset.nextLabel;
    };

    const go = (to, { scroll = true } = {}) => {
      clearTimeout(advanceTimer);
      const next = Math.max(1, Math.min(pages, to));
      if (next === page) return;
      const forward = next > page;
      page = next;
      root.classList.toggle("is-back", !forward);
      paint();
      if (forward) {
        window.lpTrackCustom?.("finder_step", {
          campaign,
          step: page,
          step_name: page === pages ? "result" : f.steps.find((s) => s.page === page)?.key,
        });
      }
      if (page === pages) {
        // Their names from page 1 are the likeliest answer to "your name".
        if (nameInput && !nameInput.value && state.names.trim()) {
          nameInput.value = state.names.trim();
        }
        countUp();
      }
      window.dispatchEvent(
        new CustomEvent("brothers:finder-step", { detail: { step: page, total: pages } })
      );
      if (scroll) keepInView();
    };

    const setMode = () => {
      stepper = mq.matches;
      root.classList.toggle("is-stepper", stepper);
      paint();
    };
    mq.addEventListener("change", setMode);
    setMode();

    nextBtn.addEventListener("click", () => {
      markStart();
      go(page + 1);
    });
    chrome.querySelector("[data-back]").addEventListener("click", () => go(page - 1));

    // A single-choice answer moves on by itself - the quiz should feel like
    // tapping through, not filling in. Re-tapping the preselected default
    // counts too; multi-select (extras) waits for "continue".
    root.querySelectorAll(".pill").forEach((btn) =>
      btn.addEventListener("click", () => {
        if (!stepper) return;
        if (btn.closest("[data-opts]").getAttribute("data-multi") === "1") return;
        const at = Number(btn.closest("[data-page]")?.dataset.page);
        if (at !== page) return;
        clearTimeout(advanceTimer);
        advanceTimer = setTimeout(() => go(page + 1), 380);
      })
    );
  })();
</script>
