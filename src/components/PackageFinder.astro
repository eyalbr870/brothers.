---
import site from "@/data/site.js";
import { packagesServiceSchema } from "@/lib/schema.js";
import LeadSource from "@/components/LeadSource.astro";
import LeadSelection from "@/components/LeadSelection.astro";
import LeadThankYou from "@/components/LeadThankYou.astro";
import reviews from "@/data/reviews.json";

// formAnchor: where "continue" scrolls to (#contact on the homepage, #lead on
//             landing pages).
// preset:     optional { guests, coverage } starting point per campaign.
// edge:       hairline on top, for where this follows a near-identical ground.
// lead:       homepage only. The card becomes the lead form itself (Netlify
//             form "finder"): the panel ends in name + phone, and submitting
//             saves the lead and opens WhatsApp to Yariv (scripts/leadForm.js,
//             data-wa-handoff). On phones the questions also turn into a
//             one-page-at-a-time stepper. Without it (/lp/*) nothing changes.
const { formAnchor = "#contact", preset = {}, edge = false, lead = false } = Astro.props;

const f = site.finder;
const l = f.lead;
const titleLines = f.title.split("\n");

// Stepper pages: each question's `page`, then one more for the result + form.
const pages = Math.max(...f.steps.map((s) => s.page ?? 1)) + 1;
// /lp/* keeps its exact markup: no scope wrapper, a plain div card.
const Scope = lead ? "div" : Fragment;
const scopeAttrs = lead ? { class: "finder__scope", "data-lead-scope": "" } : {};
const Card = lead ? "form" : "div";
const cardAttrs = lead
  ? {
      name: "finder",
      method: "POST",
      "data-netlify": "true",
      "netlify-honeypot": "bot-field",
      "data-lead-form": "",
      "data-wa-handoff": "",
      "data-uses-finder": "",
      "data-campaign": "homepage",
      "data-sending": l.sending,
      "data-error": l.error,
      "data-wa-text": l.whatsappText,
      "data-wa-number": site.contact.whatsapp,
      "data-pages": pages,
    }
  : {};
const waDirect = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(site.contact.whatsappText)}`;

// All three tiers are server-rendered in this section (the quiz only controls
// which one is displayed), so the Service/Offer markup describes content that
// genuinely exists on the page.
const siteUrl = (Astro.site || new URL("https://brothers-photography.com")).href;
const serviceSchema = packagesServiceSchema(siteUrl);

const guestsStep = f.steps.find((s) => s.key === "guests");

// Map a numeric guest count to a package tier via the step's thresholds.
const tierForGuests = (n) => {
  const [t1, t2] = guestsStep.thresholds;
  const [b, c, p] = guestsStep.tiers;
  return n <= t1 ? b : n <= t2 ? c : p;
};

// --- Server-rendered defaults (progressive enhancement) ---
const defaults = {
  guests: preset.guests ?? guestsStep.default, // numeric guest count
  coverage: preset.coverage ?? "video",
  extras: [],
  discount: "none",
  names: "",
  date: "",
};

// A wedding date in the past is never a real inquiry (same rule as LeadFields).
const today = new Date().toISOString().slice(0, 10);

// "Starting from" price for a selection. Mirrored in the inline script below
// (define:vars can't carry functions) - keep the two in sync.
const priceFor = (pkg, coverage, extras) =>
  pkg.priceStills +
  (coverage === "video" ? pkg.priceVideoAdd : 0) +
  extras.reduce((sum, id) => sum + (f.addons[id]?.price ?? 0), 0);
const formatPrice = (n) =>
  `${f.result.priceFrom}${n.toLocaleString("en-US")} ${f.result.currency}`;

const pkg0 = f.packages[tierForGuests(defaults.guests)];
const includes0 = [
  ...pkg0.stills,
  ...(defaults.coverage === "video" ? pkg0.video : []),
  ...f.common,
];

// Slider readout + track fill for the server-rendered default.
const guestsReadout0 =
  defaults.guests >= guestsStep.max
    ? guestsStep.maxLabel
    : `${defaults.guests} ${guestsStep.unit}`;
const guestsFill0 = `${((defaults.guests - guestsStep.min) / (guestsStep.max - guestsStep.min)) * 100}%`;

// WhatsApp deep link for the default selection
const coverageLabel0 =
  defaults.coverage === "video"
    ? f.result.coverageVideo
    : f.result.coverageStills;
const price0 = formatPrice(priceFor(pkg0, defaults.coverage, defaults.extras));
const waMsg0 = f.result.whatsappText
  .replace("{names}", "")
  .replace("{pkg}", pkg0.name)
  .replace("{coverage}", coverageLabel0)
  .replace("{extras}", "")
  .replace("{discount}", "")
  .replace("{guests}", guestsReadout0)
  .replace("{price}", price0)
  .replace("{date}", "");
const wa0 = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(waMsg0)}`;
---

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

<section class:list={["finder", edge && "section--edge", lead && "finder--lead"]} id="finder">
  <div class="finder__head container">
    <p class="eyebrow" data-reveal>{f.eyebrow}</p>
    <h2 class="finder__title" data-reveal>
      {titleLines.map((l) => <span>{l}</span>)}
    </h2>
    <p class="finder__subtitle" data-reveal>{f.subtitle}</p>
  </div>

  <Scope {...scopeAttrs}>
  <Card class="finder__card container" data-reveal data-finder {...cardAttrs}>
    {lead && (
      <Fragment>
        <input type="hidden" name="form-name" value="finder" />
        <p class="hidden-field" hidden>
          <label>אל תמלאו שדה זה: <input name="bot-field" /></label>
        </p>
        <LeadSource />
        <LeadSelection finderAnchor={null} />
        <input type="hidden" name="event_date" data-sel-field="date" value="" />
        <input type="hidden" name="guests" data-sel-field="guests" value="" />

        {/* Stepper chrome. Hidden until the script switches a phone into
            one-page-at-a-time mode; desktop never shows it. */}
        <div class="fstep" data-stepper hidden>
          <button type="button" class="fstep__back" data-back>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 6 15 12 9 18" /></svg>
            {f.backLabel}
          </button>
          <p class="fstep__count" aria-live="polite">
            {f.stepLabel} <b data-step-now>1</b> {f.ofLabel} {pages}
          </p>
          <div class="fstep__bar" aria-hidden="true"><span data-step-fill></span></div>
        </div>
      </Fragment>
    )}
    <div class="finder__grid">
      <!-- ============ Inputs (right in RTL) ============ -->
      <div class="finder__inputs">
        {
          f.steps.map((step) => {
            const isMulti = !!step.multi;
            // Only the stepper reads it; /lp/* markup stays untouched.
            const pageAttr = lead ? step.page ?? 1 : undefined;
            if (step.type === "details") {
              return (
                <div class="fq" data-page={pageAttr}>
                  <h3 class="fq__label">{step.q}</h3>
                  <p class="fq__help">{step.help}</p>
                  <div class="fq__fields">
                    <label class="fq__field">
                      <span>{step.namesLabel}</span>
                      <input
                        type="text"
                        data-detail="names"
                        autocomplete="off"
                        maxlength="80"
                        placeholder={step.namesPlaceholder}
                      />
                    </label>
                    <label class="fq__field">
                      <span>{step.dateLabel}</span>
                      <input type="date" data-detail="date" min={today} />
                    </label>
                  </div>
                </div>
              );
            }
            if (step.type === "slider") {
              return (
                <div class="fq" data-page={pageAttr}>
                  <div class="fq__slider-head">
                    <h3 class="fq__label">{step.q}</h3>
                    <span class="fq__readout" data-readout>{guestsReadout0}</span>
                  </div>
                  <p class="fq__help">{step.help}</p>
                  <input
                    type="range"
                    class="fq__slider"
                    data-slider
                    min={step.min}
                    max={step.max}
                    step={step.step}
                    value={defaults.guests}
                    style={`--fill:${guestsFill0}`}
                    aria-label={step.q}
                  />
                  <div class="fq__slider-ends">
                    <span>{step.minLabel}</span>
                    <span>{step.maxLabel}</span>
                  </div>
                </div>
              );
            }
            return (
              <div class="fq" data-page={pageAttr}>
                <h3 class="fq__label">{step.q}</h3>
                <p class="fq__help">{step.help}</p>
                <div
                  class="fq__opts"
                  role="group"
                  data-opts={step.key}
                  data-multi={isMulti ? "1" : "0"}
                >
                  {step.options.map((o) => {
                    const val = o.value ?? o.id;
                    const selected = isMulti
                      ? defaults.extras.includes(o.id)
                      : defaults[step.key] === val;
                    return (
                      <button
                        type="button"
                        class={`pill${selected ? " is-selected" : ""}`}
                        data-group={step.key}
                        data-value={val}
                        data-id={o.id}
                        aria-pressed={selected ? "true" : "false"}
                      >
                        <span class="pill__label">{o.label}</span>
                        <span class="pill__note">{o.note}</span>
                      </button>
                    );
                  })}
                </div>
              </div>
            );
          })
        }
        {lead && (
          <div class="fnav" data-step-nav hidden>
            <p class="fnav__live" data-live hidden>
              {l.livePrice}: <b data-live-pkg>{pkg0.name}</b> · <span data-live-price>{price0}</span>
            </p>
            <button type="button" class="btn fnav__next" data-next data-next-label={f.nextLabel} data-last-label={f.continueLabel}>
              <span data-next-text>{f.nextLabel}</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 6 9 12 15 18" /></svg>
            </button>
          </div>
        )}
      </div>

      <!-- ============ Result panel (left in RTL) ============ -->
      <aside class="finder__panel" data-panel data-page={lead ? pages : undefined}>
        <div class="panel__banner">
          <p class="panel__eyebrow">{f.result.eyebrow}</p>
          <div class="panel__name" data-r-name>{pkg0.name}</div>
          <p class="panel__tag" data-r-tag>{pkg0.tag}</p>
          <p class="panel__guests" data-r-guests>{pkg0.guests}</p>
          <p class="panel__couple" data-r-couple hidden></p>
        </div>

        <p class="panel__subtitle">{f.result.includesTitle}</p>
        <ul class="panel__list" data-r-includes>
          {includes0.map((t) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
              <span>{t}</span>
            </li>
          ))}
        </ul>

        <div class="panel__addons" data-r-addons hidden>
          <p class="panel__subtitle">{f.result.addonsTitle}</p>
          <div class="panel__chips" data-r-chips></div>
        </div>

        <div class="panel__price">
          <p class="panel__subtitle">{f.result.priceTitle}</p>
          <p class="panel__price-value" data-r-price aria-live="polite">
            <s class="panel__price-was" data-r-price-was hidden></s>
            <span data-r-price-now>{price0}</span>
          </p>
          <p class="panel__discount" data-r-discount hidden></p>
          <p class="panel__price-note">{f.result.priceNote}</p>
        </div>

        {lead ? (
        <div class="panel__cta-block">
          <h3 class="panel__cta-heading">{l.heading}</h3>
          <p class="panel__cta-text">{l.text}</p>
          <div class="flead">
            <label class="fq__field">
              <span>{l.nameLabel} *</span>
              <input name="name" type="text" required autocomplete="name" maxlength="80" placeholder=" " data-lead-name />
            </label>
            <label class="fq__field">
              <span>{l.phoneLabel} *</span>
              <input
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                inputmode="tel"
                pattern="[0-9+\-\s()]{9,}"
                title={site.contactSection.form.phoneHint}
                placeholder=" "
              />
            </label>
            <div class="flead__item">
              <label class="fq__field">
                <span>{l.venueLabel} *</span>
                <input
                  name="venue"
                  type="text"
                  required
                  autocomplete="off"
                  maxlength="120"
                  placeholder=" "
                  aria-describedby="finder-venue-error"
                  data-lead-venue
                />
              </label>
              <p class="flead__error" id="finder-venue-error" data-venue-error hidden>{l.venueError}</p>
            </div>
          </div>
          <button class="btn panel__cta" type="submit" data-submit>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.5 9.5 0 01-4.84-1.33l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 01-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.43 9.43 0 012.78 6.72c0 5.24-4.26 9.5-9.5 9.5zm5.53-15.01A11.42 11.42 0 0012.03.5C5.74.5.62 5.62.62 11.9c0 2.09.55 4.13 1.6 5.92L.5 23.5l5.82-1.53a11.36 11.36 0 005.71 1.46h.01c6.28 0 11.4-5.12 11.4-11.4 0-3.05-1.19-5.91-3.35-8.06z"/></svg>
            <span data-submit-label>{l.submit}</span>
          </button>
          {/* Social proof at the moment of hesitation. Same source as the
              trust band and the reviews section, never typed by hand. */}
          <p class="flead__trust">
            <span class="flead__stars" aria-hidden="true">★★★★★</span>
            <span>{`${reviews.score}/${reviews.scoreMax} · ${reviews.count} זוגות ב-mit4mit`}</span>
          </p>
          <p class="form__micro">{l.micro}</p>
          <p class="form__status" data-status role="status" aria-live="polite"></p>
          <a
            class="panel__link"
            href={waDirect}
            target="_blank"
            rel="noopener"
            data-track="contact"
            data-track-method="whatsapp"
            data-track-loc="finder_direct"
          >{l.direct}</a>
        </div>
        ) : (
        <div class="panel__cta-block">
          <h3 class="panel__cta-heading">{f.result.ctaHeading}</h3>
          <p class="panel__cta-text">{f.result.ctaText}</p>
          <a
            class="btn panel__cta"
            data-r-wa
            data-track="contact"
            data-track-method="whatsapp"
            data-track-loc="finder"
            href={wa0}
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.5 9.5 0 01-4.84-1.33l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 01-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.43 9.43 0 012.78 6.72c0 5.24-4.26 9.5-9.5 9.5zm5.53-15.01A11.42 11.42 0 0012.03.5C5.74.5.62 5.62.62 11.9c0 2.09.55 4.13 1.6 5.92L.5 23.5l5.82-1.53a11.36 11.36 0 005.71 1.46h.01c6.28 0 11.4-5.12 11.4-11.4 0-3.05-1.19-5.91-3.35-8.06z"/></svg>
            <span>{f.result.ctaWhatsapp}</span>
          </a>
          <a class="panel__link" href={formAnchor} data-r-continue>{f.result.ctaForm}</a>
        </div>
        )}
      </aside>
    </div>
  </Card>
  {lead && (
    <div class="container finder__thanks">
      <LeadThankYou variant="handoff" />
    </div>
  )}
  </Scope>
</section>

<!-- Global because option pills / result nodes are re-rendered at runtime in
     JS and would not receive Astro's scoped-style attribute. All selectors are
     namespaced under .finder to avoid leaking. -->
<style is:global>
  .finder {
    background: var(--cream);
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem);
  }
  .finder__head {
    text-align: center;
    max-width: 760px;
    margin-block-end: clamp(2rem, 1rem + 3vw, 3.4rem);
  }
  .finder__head .eyebrow { margin-block-end: 1rem; }
  .finder__title {
    font-size: var(--fs-h2);
    line-height: 1.05;
    margin-block-end: 1.1rem;
  }
  .finder__title span { display: block; }
  .finder__subtitle {
    color: var(--ink-60);
    font-weight: 300;
    font-size: var(--fs-lead);
    max-width: 640px;
    margin-inline: auto;
  }

  /* ---- Outer card ---- */
  .finder__card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 24px;
    box-shadow: 0 40px 80px -50px rgba(69, 50, 38, 0.55);
    padding: clamp(1.4rem, 1rem + 3vw, 3.2rem);
  }
  .finder__grid {
    display: grid;
    grid-template-columns: 1fr 0.92fr;
    gap: clamp(1.6rem, 1rem + 3vw, 3.4rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .finder__grid { grid-template-columns: 1fr; }
  }

  /* ---- Inputs ---- */
  .finder .fq { margin-block-end: clamp(1.8rem, 1rem + 2vw, 2.6rem); }
  .finder .fq:last-child { margin-block-end: 0; }
  .finder .fq__label {
    font-size: var(--fs-h3);
    line-height: 1.15;
    margin-block-end: 0.35rem;
  }
  .finder .fq__help {
    color: var(--ink-60);
    font-weight: 300;
    font-size: 0.98rem;
    margin-block-end: 1rem;
  }

  /* ---- Slider (guest count) ---- */
  .finder .fq__slider-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 0.35rem;
  }
  .finder .fq__slider-head .fq__label { margin-block-end: 0; }
  .finder .fq__readout {
    flex: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--chestnut);
    white-space: nowrap;
  }
  .finder .fq__slider {
    -webkit-appearance: none;
    appearance: none;
    direction: rtl; /* 0 on the right, max on the left */
    width: 100%;
    height: 6px;
    border-radius: 100px;
    background: linear-gradient(
      to left,
      var(--chestnut) var(--fill, 0%),
      var(--cream-2) var(--fill, 0%)
    );
    cursor: pointer;
    outline-offset: 6px;
  }
  .finder .fq__slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    border: 1.5px solid var(--chestnut);
    box-shadow: 0 4px 12px -3px rgba(69, 50, 38, 0.5);
    transition: transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .finder .fq__slider::-webkit-slider-thumb:hover,
  .finder .fq__slider:active::-webkit-slider-thumb {
    transform: scale(1.12);
    box-shadow: 0 6px 16px -3px rgba(69, 50, 38, 0.55);
  }
  .finder .fq__slider::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    border: 1.5px solid var(--chestnut);
    box-shadow: 0 4px 12px -3px rgba(69, 50, 38, 0.5);
  }
  .finder .fq__slider::-moz-range-track {
    height: 6px;
    border-radius: 100px;
    background: transparent;
  }
  .finder .fq__slider-ends {
    display: flex;
    justify-content: space-between;
    margin-block-start: 0.6rem;
    font-size: 0.85rem;
    color: var(--ink-60);
    font-weight: 300;
  }

  /* ---- Names + date ---- */
  .finder .fq__fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.7rem;
  }
  .finder .fq__field { display: grid; gap: 0.35rem; }
  .finder .fq__field span {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--espresso);
  }
  .finder .fq__field input {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    font: inherit;
    color: var(--espresso);
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: 12px;
    transition: border-color 0.3s var(--ease);
  }
  .finder .fq__field input::placeholder { color: var(--ink-60); font-weight: 300; }
  .finder .fq__field input:hover,
  .finder .fq__field input:focus { border-color: var(--mocha); outline: none; }
  .finder .fq__field input:focus-visible { box-shadow: 0 0 0 3px var(--cream-2); }

  .finder .fq__opts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.7rem;
  }
  .finder .pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    text-align: center;
    padding: 0.85rem 0.9rem;
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: 12px;
    transition:
