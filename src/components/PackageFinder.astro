  .finder__card.is-stepper .fq__slider { height: 8px; margin-block: 1.4rem 0.4rem; }
  .finder__card.is-stepper .fq__slider::-webkit-slider-thumb { width: 34px; height: 34px; }
  .finder__card.is-stepper .fq__readout { font-size: 1.5rem; }
  .finder__card.is-stepper .fq__fields { grid-template-columns: 1fr; }

  /* Result page: name and price first, then the send form, then the detail. */
  .finder__card.is-stepper .finder__panel {
    display: flex;
    flex-direction: column;
    padding: 1.2rem;
    margin-inline: -0.3rem;
  }
  .finder__card.is-stepper .finder__panel > * { order: 3; }
  .finder__card.is-stepper .panel__banner { order: 0; margin-block-end: 1.1rem; }
  .finder__card.is-stepper .panel__price {
    order: 1;
    margin-block-start: 0;
    padding-block-start: 0;
    border: 0;
    text-align: center;
  }
  .finder__card.is-stepper .panel__cta-block { order: 2; margin-block-end: 1.6rem; }
  .finder__card.is-stepper .panel__cta-block + * {
    padding-block-start: 1.4rem;
    border-block-start: 1px solid var(--line);
  }

  /* Page swap: forward slides in from the left (RTL reading direction),
     back from the right. */
  .finder__card.is-stepper .is-on { animation: fstepIn 0.45s var(--ease) both; }
  .finder__card.is-stepper.is-back .is-on { animation-name: fstepBack; }
  .finder__card.is-stepper.is-result .panel__banner {
    animation: fstepReveal 0.7s var(--ease) both;
  }
  @keyframes fstepIn {
    from { opacity: 0; transform: translateX(-28px); }
    to { opacity: 1; transform: none; }
