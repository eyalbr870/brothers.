  /* The flex/grid displays below would otherwise beat the hidden attribute. */
  .finder__card.is-stepper [data-page][hidden] { display: none; }
  .finder__card.is-stepper .finder__inputs {
    display: flex;
    flex-direction: column;
    min-height: 26rem;
  }
  .finder__card.is-stepper.is-result .finder__inputs { display: none; }
  .finder__card.is-stepper .fq { margin-block-end: 1.6rem; }
  .finder__card.is-stepper .fq__label { font-size: 1.6rem; }
  /* One question per screen: give the choices room to be tapped. */
  .finder__card.is-stepper .fq__opts { grid-template-columns: 1fr; }
  .finder__card.is-stepper .pill {
    flex-direction: row;
