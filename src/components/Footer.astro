---
import site from "@/data/site.js";
const year = new Date().getFullYear();
// Landing pages pass nav={false} - the home anchors (#hero, #gallery…) don't
// exist there, so the nav row would dead-scroll.
const { nav = true } = Astro.props;
// "/" rather than "#hero": on the homepage it still returns to the top, and on
// the landing/blog pages it becomes a real internal link home instead of an
// anchor pointing at a section that does not exist there.
const brandHref = nav ? "#hero" : "/";
---

<footer class="footer">
  <div class="container footer__inner">
    <a class="footer__brand" href={brandHref}>
      <img src="/logo/logo-white.png" alt={site.brand} width="220" height="64" />
    </a>
    <p class="footer__tagline">{site.footer.tagline}</p>

    {nav && (
      <nav class="footer__nav" aria-label="ניווט תחתון">
        {site.nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    )}

    <div class="footer__social">
      <a href={site.contact.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
      </a>
      <a href={`https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(site.contact.whatsappText)}`} target="_blank" rel="noopener" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"/></svg>
      </a>
    </div>

    <div class="footer__meta">
      <span>© {year} {site.footer.credit} · {site.footer.rights}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--espresso);
    color: rgba(247, 241, 232, 0.82);
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
    text-align: center;
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }
  .footer__brand img {
    height: 54px;
    width: auto;
    opacity: 0.96;
  }
  .footer__tagline {
    font-family: var(--font-body);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--sand);
  }
  .footer__nav {
    display: flex;
    gap: 1.8rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .footer__nav a {
    font-weight: 600;
    color: rgba(247, 241, 232, 0.82);
    position: relative;
    transition: color 0.3s var(--ease);
  }
  .footer__nav a:hover { color: #fff; }
  .footer__social {
    display: flex;
    gap: 1rem;
  }
  .footer__social a {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(247, 241, 232, 0.22);
    color: var(--sand);
    transition: background 0.3s var(--ease), color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .footer__social a:hover {
    background: var(--sand);
    color: var(--espresso);
    transform: translateY(-2px);
  }
  .footer__meta {
    margin-block-start: 0.6rem;
    font-size: 0.82rem;
    color: rgba(247, 241, 232, 0.55);
    letter-spacing: 0.03em;
  }
</style>
