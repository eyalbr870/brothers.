---
import { getCollection } from "astro:content";
import campaigns from "@/data/landing.js";

// Every /lp/ page was a dead end: zero links out, to anything. The homepage
// has ServiceLinks as its hub, but a visitor - or a crawler - that lands on an
// ad page from search had nowhere to go but the form. This block gives each
// page a short, hand-picked set of next steps from campaign.related.
//
// The picks live in landing.js so they stay per campaign; a slug that is
// removed, renamed or still a draft simply drops out instead of turning into
// a dead link.
const { campaign } = Astro.props;

const related = campaign.related ?? {};

const posts = await getCollection("blog", ({ data }) => !data.draft);
const guides = (related.guides ?? [])
  .map((slug) => posts.find((p) => p.slug === slug))
  .filter(Boolean)
  .map((p) => ({ href: `/blog/${p.slug}/`, label: p.data.title }));

// Short labels rather than the campaign's own hero title: this is a nav list,
// not a second headline.
const LABELS = {
  stills: "צילום סטילס לחתונה",
  video: "צלם וידאו וסרט חתונה",
  "video-stills": "חבילת סטילס + וידאו",
  "weddings-small": "חתונה קטנה ואינטימית",
  "weddings-big-center": "חתונה גדולה במרכז",
  "weddings-outdoor": "חתונת שטח וטבע",
  "weddings-concept": "חתונת קונספט",
  "business-events": "אירועים עסקיים וכנסים",
  "wedding-photographer-israel": "צלם חתונות בכל הארץ",
  "weddings-ashdod": "צלם חתונות באשדוד",
};

const known = new Set(campaigns.map((c) => c.slug));
const pages = (related.pages ?? [])
  .filter((slug) => slug !== campaign.slug && known.has(slug) && LABELS[slug])
  .map((slug) => ({ href: `/lp/${slug}/`, label: LABELS[slug] }));
---

{(guides.length > 0 || pages.length > 0) && (
  <section class="lprel section" aria-labelledby="lprel-title">
    <div class="container">
      <header class="lprel__head">
        <p class="eyebrow" data-reveal>MORE</p>
        <h2 class="lprel__title" id="lprel-title" data-reveal>
          שווה לקרוא לפני שסוגרים
        </h2>
      </header>

      <div class="lprel__cols">
        {guides.length > 0 && (
          <div class="lprel__col">
            <h3 class="lprel__subtitle" data-reveal>מדריכים</h3>
            <ul class="lprel__list">
              {guides.map((g, i) => (
                <li class="lprel__li" data-reveal style={`--i:${i}`}>
                  <a class="lprel__link" href={g.href}>{g.label}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {pages.length > 0 && (
          <div class="lprel__col">
            <h3 class="lprel__subtitle" data-reveal>שירותים נוספים</h3>
            <ul class="lprel__list">
              {pages.map((p, i) => (
                <li class="lprel__li" data-reveal style={`--i:${i}`}>
                  <a class="lprel__link" href={p.href}>{p.label}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .lprel { background: var(--paper); }
  [data-reveal] { transition-delay: calc(var(--i, 0) * 0.06s); }

  .lprel__head { margin-block-end: clamp(1.6rem, 1rem + 1.5vw, 2.4rem); }
  .lprel__head .eyebrow { margin-block-end: 0.8rem; }
  .lprel__title { font-size: var(--fs-h2); }

  .lprel__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
  }
  @media (max-width: 700px) {
    .lprel__cols { grid-template-columns: 1fr; }
  }

  .lprel__subtitle {
    font-size: var(--fs-h3);
    margin-block-end: 1rem;
  }

  .lprel__list {
    list-style: none;
    display: grid;
    gap: 0.2rem;
  }
  .lprel__li {
    border-block-start: 1px solid var(--sand);
  }
  .lprel__li:last-child {
    border-block-end: 1px solid var(--sand);
  }

  .lprel__link {
    display: block;
    padding-block: 0.9rem;
    font-size: 1.02rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s ease, padding-inline-start 0.2s ease;
  }
  .lprel__link:hover,
  .lprel__link:focus-visible {
    color: var(--chestnut);
    padding-inline-start: 0.4rem;
  }
</style>
