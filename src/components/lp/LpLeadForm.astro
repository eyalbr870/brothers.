---
import site from "@/data/site.js";

const { campaign } = Astro.props;
const base = site.contactSection.form;
const f = { ...base, ...(campaign.form ?? {}) };

const eyebrow = campaign.form?.eyebrow ?? "GET IN TOUCH";
const title = campaign.form?.title ?? "בואו נדבר";
const subtitle = campaign.form?.subtitle ?? site.contactSection.subtitle;

const waText = campaign.whatsappText ?? site.contact.whatsappText;
const wa = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(waText)}`;
---

<section class="lplead" id="lead">
  <div class="lplead__inner">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h2 class="lplead__title" data-reveal>{title}</h2>
    <p class="lplead__subtitle" data-reveal>{subtitle}</p>

    <form
      class="form"
      data-lp-form
      name="lead"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-reveal
    >
      <input type="hidden" name="form-name" value="lead" />
      <input type="hidden" name="campaign" value={campaign.slug} />
      <input type="hidden" name="lp_url" value={Astro.url.pathname} />
      <input type="hidden" name="referrer" data-referrer value="" />
      <p class="hidden-field" hidden>
        <label>אל תמלאו שדה זה: <input name="bot-field" /></label>
      </p>
      <div class="form__row">
        <div class="field">
          <input id="lf-name" name="name" type="text" required autocomplete="name" placeholder=" " />
          <label for="lf-name">{f.name}</label>
        </div>
        <div class="field">
          <input id="lf-phone" name="phone" type="tel" required autocomplete="tel" placeholder=" " />
          <label for="lf-phone">{f.phone}</label>
        </div>
      </div>
      <div class="form__row">
        <div class="field">
          <input id="lf-email" name="email" type="email" autocomplete="email" placeholder=" " />
          <label for="lf-email">{f.email}</label>
        </div>
        <div class="field">
          <input id="lf-date" name="event_date" type="text" placeholder=" " onfocus="this.type='date'" onblur="if(!this.value)this.type='text'" />
          <label for="lf-date">{f.date}</label>
        </div>
      </div>
      <div class="field">
        <textarea id="lf-msg" name="message" rows="3" placeholder=" "></textarea>
        <label for="lf-msg">{f.message}</label>
      </div>
      <button class="btn form__submit" type="submit" data-submit>
        <span data-submit-label>{f.submit}</span>
      </button>
      <p class="form__status" data-status role="status" aria-live="polite"></p>
    </form>

    <div class="lplead__direct" data-reveal>
      <span class="lplead__direct-label">{site.contactSection.directLabel}</span>
      <div class="lplead__links">
        <a class="clink" href={wa} target="_blank" rel="noopener" data-lp-wa aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"/></svg>
          <span>WhatsApp</span>
        </a>
        <a class="clink" href={`tel:${site.contact.phoneIntl}`} data-lp-call aria-label="טלפון">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 1.9.7 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.8.6 2.8.7a2 2 0 011.7 2z"/></svg>
          <span dir="ltr">{site.contact.phoneDisplay}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .lplead {
    background: var(--cream);
    padding: clamp(3rem, 2rem + 5vw, 6rem) var(--gutter);
    /* room so the mobile sticky bar never covers the submit */
    padding-block-end: clamp(5.5rem, 4rem + 6vw, 6rem);
  }
  .lplead__inner {
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
  }
  .lplead .eyebrow { margin-block-end: 1rem; }
  .lplead__title {
    font-size: var(--fs-h2);
    line-height: 1.05;
    margin-block-end: 1rem;
  }
  .lplead__subtitle {
    color: var(--ink-60);
    font-weight: 300;
    font-size: var(--fs-lead);
    margin-block-end: 2.2rem;
  }

  /* ---- Form (mirrors Contact.astro) ---- */
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 480px) {
    .form__row { grid-template-columns: 1fr; }
  }
  .field {
    position: relative;
    margin-block-end: 1rem;
  }
  .field input,
  .field textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--espresso);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.15rem 1rem 0.5rem;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .field textarea {
    padding-top: 1.4rem;
    resize: vertical;
    min-height: 100px;
  }
  .field label {
    position: absolute;
    inset-inline-start: 1rem;
    top: 0.95rem;
    font-size: 1rem;
    color: var(--ink-45);
    pointer-events: none;
    transition: transform 0.22s var(--ease), font-size 0.22s var(--ease), color 0.22s var(--ease);
    transform-origin: inline-start;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--chestnut);
    box-shadow: 0 0 0 3px rgba(125, 88, 68, 0.12);
  }
  .field input:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label,
  .field textarea:not(:placeholder-shown) + label {
    transform: translateY(-0.7rem) scale(0.8);
    color: var(--chestnut);
  }
  .form__submit {
    width: 100%;
    margin-block-start: 0.4rem;
  }
  .form__status {
    margin-block-start: 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    min-height: 1.4em;
  }
  .form__status.is-ok { color: #4b7d4b; }
  .form__status.is-err { color: #b0483a; }

  /* ---- Direct links ---- */
  .lplead__direct {
    margin-block-start: 2.4rem;
    padding-block-start: 1.6rem;
    border-block-start: 1px solid var(--line);
  }
  .lplead__direct-label {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--mocha);
    display: block;
    margin-block-end: 1rem;
  }
  .lplead__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .clink {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 100px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--espresso);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease), color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .clink:hover {
    transform: translateY(-2px);
    border-color: var(--chestnut);
    color: var(--chestnut);
    background: #fff;
  }
  .clink svg { flex: none; }
</style>

<script is:inline define:vars={{ formCfg: { sending: f.sending, success: f.success, error: f.error }, slug: campaign.slug }}>
  const form = document.querySelector("[data-lp-form]");
  const status = form?.querySelector("[data-status]");
  const submit = form?.querySelector("[data-submit]");
  const label = form?.querySelector("[data-submit-label]");
  const referrer = form?.querySelector("[data-referrer]");

  // Capture the ad source (utm / click id / referrer) for attribution.
  if (referrer) {
    referrer.value = (location.search || "") + (document.referrer ? " | ref:" + document.referrer : "");
  }

  // WhatsApp / Call attribution events.
  form?.querySelector("[data-lp-wa]")?.addEventListener("click", () => {
    window.lpTrack?.("Contact", { method: "whatsapp", campaign: slug });
  });
  form?.querySelector("[data-lp-call]")?.addEventListener("click", () => {
    window.lpTrackCustom?.("Call", { campaign: slug });
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    status.className = "form__status";
    status.textContent = "";

    if (location.hostname === "localhost" || location.hostname === "127.0.0.1") {
      status.classList.add("is-err");
      status.textContent = "בסביבת פיתוח הטופס אינו נשלח - יעבוד לאחר פריסה ל‑Netlify.";
      return;
    }

    submit.disabled = true;
    const original = label.textContent;
    label.textContent = formCfg.sending;
    try {
      const res = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(new FormData(form)).toString(),
      });
      if (res.ok) {
        form.reset();
        status.classList.add("is-ok");
        status.textContent = formCfg.success;
        window.lpTrack?.("Lead", { campaign: slug });
      } else {
        throw new Error("bad response");
      }
    } catch {
      status.classList.add("is-err");
      status.textContent = formCfg.error;
    } finally {
      submit.disabled = false;
      label.textContent = original;
    }
  });
</script>
