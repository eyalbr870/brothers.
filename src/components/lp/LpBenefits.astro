---
const { campaign } = Astro.props;
const items = campaign.benefits ?? [];
const heading = campaign.benefitsTitle ?? "למה לבחור ב-Brothers.";
const eyebrow = campaign.benefitsEyebrow ?? "WHY US";

// Inline SVG icon set (stroke-based, currentColor). Keyed by benefit.icon.
const icons = {
  camera: '<path d="M4 8h3l2-2h6l2 2h3a1 1 0 011 1v9a1 1 0 01-1 1H4a1 1 0 01-1-1V9a1 1 0 011-1z"/><circle cx="12" cy="13" r="3.2"/>',
  video: '<rect x="3" y="7" width="12" height="10" rx="2"/><path d="M15 10l6-3v10l-6-3z"/>',
  film: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"/>',
  heart: '<path d="M12 20s-7-4.4-9.2-8.4A5 5 0 0112 5a5 5 0 019.2 6.6C19 15.6 12 20 12 20z"/>',
  star: '<path d="M12 3.5l2.6 5.3 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.7 1-5.8L3.5 9.6l5.9-.8L12 3.5z"/>',
  map: '<path d="M9 3L3 5v16l6-2 6 2 6-2V3l-6 2-6-2z"/><path d="M9 3v16M15 5v16"/>',
  users: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.5 5.5 0 0111 0"/><path d="M16 5.2a3.2 3.2 0 010 6M17.5 20a5.5 5.5 0 00-3-4.9"/>',
  sparkle: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/><path d="M19 15l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2z"/>',
  briefcase: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2M3 12h18"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9"/>',
  gem: '<path d="M6 3h12l3 6-9 12L3 9l3-6z"/><path d="M3 9h18M9 3l3 6 3-6M12 9v12"/>',
};
---

{items.length > 0 && (
  <section class="lpben section">
    <div class="container">
      <header class="lpben__head">
        <p class="eyebrow" data-reveal>{eyebrow}</p>
        <h2 class="lpben__heading" data-reveal>{heading}</h2>
      </header>
      <ul class="lpben__grid">
        {items.map((b, i) => (
          <li class="lpben__card" data-reveal style={`--i:${i}`}>
            <span class="lpben__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon] ?? icons.star} />
            </span>
            <h3 class="lpben__title">{b.title}</h3>
            <p class="lpben__text">{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .lpben {
    background: var(--paper);
  }
  .lpben__head {
    text-align: center;
    margin-block-end: clamp(1.8rem, 1rem + 2vw, 3rem);
  }
  .lpben__head .eyebrow { margin-block-end: 0.8rem; }
  .lpben__heading { font-size: var(--fs-h2); }
  .lpben__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
  }
  @media (max-width: 900px) {
    .lpben__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .lpben__grid { grid-template-columns: 1fr; }
  }
  /* Spotlight-follows-cursor effect, ported from React Bits' SpotlightCard
     (reactbits.dev) to vanilla Astro and re-tuned to the warm brand palette. */
  .lpben__card {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    border: 1px solid var(--line-soft);
    border-radius: 6px;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.2rem);
    text-align: center;
    --mouse-x: 50%;
    --mouse-y: 50%;
    --spotlight-color: rgba(125, 88, 68, 0.16); /* chestnut glow */
    transition: border-color 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .lpben__card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(
      circle at var(--mouse-x) var(--mouse-y),
      var(--spotlight-color),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }
  .lpben__card:hover,
  .lpben__card:focus-within {
    border-color: var(--sand);
    transform: translateY(-3px);
  }
  .lpben__card:hover::before,
  .lpben__card:focus-within::before {
    opacity: 1;
  }
  /* Keep the card content above the glow layer. */
  .lpben__card > * {
    position: relative;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .lpben__card { transition: none; }
    .lpben__card:hover,
    .lpben__card:focus-within { transform: none; }
  }
  [data-reveal] { transition-delay: calc(var(--i, 0) * 0.07s); }
  .lpben__icon {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--sand);
    color: var(--chestnut);
    margin-block-end: 1.1rem;
  }
  .lpben__title {
    font-size: var(--fs-h3);
    margin-block-end: 0.5rem;
  }
  .lpben__text {
    color: var(--ink-60);
    font-weight: 300;
    line-height: 1.6;
    font-size: 1rem;
  }
</style>

<script>
  // Track the cursor per card and expose it as CSS vars for the radial glow.
  for (const card of document.querySelectorAll(".lpben__card")) {
    card.addEventListener("pointermove", (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
      card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
    });
  }
</script>
