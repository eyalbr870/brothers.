---
import { howToSchema } from "@/lib/schema.js";

const { campaign } = Astro.props;

const included = campaign.included ?? [];

// Universal booking flow. Neutral wording works for every campaign
// (weddings, video, business events). Override per campaign with
// campaign.process = [{ title, text }, ...].
const process = campaign.process ?? [
  { title: "משאירים פרטים", text: "טופס קצר או הודעה בוואטסאפ, ואחזור אליכם עוד באותו יום." },
  { title: "שיחת היכרות", text: "מתאמים ציפיות, חבילה ולוקיישנים, ומכירים עוד לפני היום עצמו." },
  { title: "ביום עצמו", text: "מלווים אתכם צמוד לאורך כל האירוע. קרוב, בלי לביים ובלי להפריע." },
  { title: "מקבלים את התמונות", text: "גלריה דיגיטלית עם כל התמונות הערוכות, מוכנה לשיתוף עם חברים ומשפחה." },
];

const inclTitle = campaign.includedTitle ?? "מה כלול בשירות";

// valueCompact (homepage only): on phones the list shows its first items with
// a "show all" button, and the steps become a swipeable row. /lp/* doesn't set
// it, so its markup is unchanged.
const compact = !!campaign.valueCompact;
const SHOWN = 4;

// The four steps were already written and headed on every landing page; only
// the markup was missing. HowTo is the format search and voice engines lift a
// step-by-step answer from. Built in src/lib/schema.js per METHOD §6.
const howTo = process.length > 0 && howToSchema(process);
---

{howTo && (
  <script type="application/ld+json" set:html={JSON.stringify(howTo)} />
)}

{(included.length > 0 || process.length > 0) && (
  <section class:list={["lpvalue section", compact && "lpvalue--compact"]}>
    <div class="container lpvalue__inner">
      {included.length > 0 && (
        <div class="lpvalue__block">
          <header class="lpvalue__head">
            <p class="eyebrow" data-reveal>WHAT'S INCLUDED</p>
            <h2 class="lpvalue__title" data-reveal>{inclTitle}</h2>
          </header>
          <ul class="lpvalue__list">
            {included.map((item, i) => (
              <li
                class:list={["lpvalue__li", compact && i >= SHOWN && "lpvalue__li--extra"]}
                data-reveal
                style={`--i:${i}`}
              >
                <span class="lpvalue__check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          {compact && included.length > SHOWN && (
            <button class="lpvalue__more" type="button" data-value-more>
              {`ועוד ${included.length - SHOWN} דברים שכלולים`}
            </button>
          )}
        </div>
      )}

      {process.length > 0 && (
        <div class="lpvalue__block lpvalue__block--process">
          <header class="lpvalue__head">
            <p class="eyebrow" data-reveal>HOW IT WORKS</p>
            <h3 class="lpvalue__subtitle" data-reveal>איך זה עובד</h3>
          </header>
          <ol class="lpvalue__steps" data-swipe={compact ? "" : undefined}>
            {process.map((step, i) => (
              <li class="lpvalue__step" data-reveal style={`--i:${i}`}>
                <span class="lpvalue__num" aria-hidden="true">{i + 1}</span>
                <h4 class="lpvalue__step-title">{step.title}</h4>
                <p class="lpvalue__step-text">{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      )}

      {campaign.valueCta && (
        <div class="lpvalue__cta" data-reveal>
          <a
            class="btn"
            href={campaign.valueCta.href}
            data-track="cta"
            data-track-loc="value"
            data-track-label="availability"
          >
            {campaign.valueCta.label}
          </a>
        </div>
      )}
    </div>
  </section>
)}

{compact && (
  <script is:inline>
    (() => {
      const sec = document.querySelector(".lpvalue--compact");
      const btn = sec?.querySelector("[data-value-more]");
      if (!btn) return;
      sec.classList.add("is-folded");
      btn.addEventListener("click", () => {
        sec.classList.remove("is-folded");
        btn.remove();
      });
    })();
  </script>
)}

<style>
  .lpvalue { background: var(--paper); }
  .lpvalue__more { display: none; }
  @media (max-width: 760px) {
    .lpvalue--compact.is-folded .lpvalue__li--extra { display: none; }
    .lpvalue--compact .lpvalue__more {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-block-start: 0.6rem;
      font-weight: 600;
      color: var(--chestnut);
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    /* Grid items default to min-width:auto, which let the swipe row push the
       whole page sideways. */
    .lpvalue--compact .lpvalue__inner > * { min-width: 0; }
    .lpvalue--compact .lpvalue__step {
      padding: 1.2rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--cream);
    }
  }
  .lpvalue__inner {
    display: grid;
    gap: clamp(2.8rem, 2rem + 4vw, 5rem);
  }
  [data-reveal] { transition-delay: calc(var(--i, 0) * 0.06s); }

  /* Step 1 of this section reads "leave your details and I'll get back to you
     today" - this is the second half of that sentence. */
  .lpvalue__cta {
    display: flex;
    justify-content: center;
    padding-block-start: clamp(2rem, 1.4rem + 1.6vw, 3rem);
    border-block-start: 1px solid var(--rule);
  }

  .lpvalue__head { margin-block-end: clamp(1.6rem, 1rem + 1.5vw, 2.4rem); }
  .lpvalue__head .eyebrow { margin-block-end: 0.8rem; }
  .lpvalue__title { font-size: var(--fs-h2); }
  .lpvalue__subtitle { font-size: var(--fs-h2); }

  /* ---- What's included ---- */
  .lpvalue__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }
  @media (max-width: 600px) {
    .lpvalue__list { grid-template-columns: 1fr; }
  }
  .lpvalue__li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink);
    padding-block: 0.35rem;
  }
  .lpvalue__check {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--sand);
    color: var(--chestnut);
    margin-block-start: 0.05rem;
  }

  /* ---- How it works ---- */
  .lpvalue__steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.2rem, 0.6rem + 2vw, 2.4rem);
    counter-reset: step;
  }
  @media (max-width: 820px) {
    .lpvalue__steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 460px) {
    .lpvalue__steps { grid-template-columns: 1fr; }
  }
  .lpvalue__step { position: relative; }
  .lpvalue__num {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--chestnut);
    color: var(--chestnut);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.25rem;
    margin-block-end: 1rem;
  }
  .lpvalue__step-title {
    font-size: var(--fs-h3);
    margin-block-end: 0.4rem;
  }
  .lpvalue__step-text {
    color: var(--ink-60);
    font-weight: 300;
    line-height: 1.6;
    font-size: 0.98rem;
  }
</style>
