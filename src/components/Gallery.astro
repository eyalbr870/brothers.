---
import site from "@/data/site.js";
import manifest from "@/data/gallery.generated.json";
import { srcset, fallbackSrc } from "@/lib/images.js";

const items = manifest.items;

// ---- DriftWall layout ----
const COLUMNS = 5; // drifting columns (reduced responsively via CSS/JS)

// How many photos are baked into the HTML. The wall used to ship every photo
// three times over (one stack per COPIES loop), which was ~222KB of markup and
// 174 <img> tags on a page whose whole budget is smaller than that. Now the
// document carries one stack of the first INITIAL photos; the runtime clones
// it into the looping copies (free, no markup) and the remaining photos arrive
// only when a visitor asks for them via "עוד תמונות".
//
// INITIAL is a multiple of COLUMNS so every column starts equally deep.
const INITIAL = 25;
const initial = items.slice(0, INITIAL);
const deferredCount = items.length - initial.length;

// Distribute items round-robin across columns, keeping each item's original
// manifest index so the lightbox opens the right photo. The deferred photos
// keep the same rule client-side (column = index % COLUMNS), so the wall fills
// in evenly.
const columns = Array.from({ length: COLUMNS }, () => []);
initial.forEach((it, i) => columns[i % COLUMNS].push({ item: it, index: i }));

// Every tile is a fixed-size cover crop; a small src is plenty.
const tileSizes = "220px";
---

<section class="gallery section section--edge" id="gallery">
  <div class="container">
    <header class="gallery__head">
      <p class="eyebrow" data-reveal>{site.gallery.eyebrow}</p>
      <h2 class="gallery__title" data-reveal>{site.gallery.title}</h2>
      <p class="gallery__subtitle" data-reveal>{site.gallery.subtitle}</p>
    </header>
  </div>

  <div class="drift-wall" data-wall role="group" aria-label="קיר תמונות מתוך יום החתונה">
    <div class="drift-wall__plane" data-plane>
      {columns.map((col, c) => (
        <div class="drift-wall__col">
          {/* One stack only. The runtime clones it into the looping copies. */}
          <div class="drift-wall__track" data-track data-col={c}>
            {col.map(({ item, index }) => (
              <button
                class="drift-wall__tile"
                type="button"
                data-open={index}
                data-col={c}
                data-tile-id={`${c}-0-${index}`}
                aria-label={`הגדלת תמונה ${index + 1}`}
              >
                <span class="drift-wall__inner">
                  <picture>
                    <source type="image/webp" srcset={srcset(item, "webp")} sizes={tileSizes} />
                    <source type="image/jpeg" srcset={srcset(item, "jpg")} sizes={tileSizes} />
                    <img
                      src={fallbackSrc(item, "jpg")}
                      alt={`רגע מתוך יום החתונה - ${index + 1}`}
                      width={item.width}
                      height={item.height}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                      style={`background-image:url('${item.lqip}')`}
                      onload="this.classList.add('is-loaded')"
                    />
                    <span class="drift-wall__overlay" aria-hidden="true"></span>
                  </picture>
                </span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  {/* Prototype tile for the deferred photos. Cloning this (rather than
      building markup from a string) is what keeps Astro's scoped-style
      attributes on the generated tiles. */}
  <template data-tile-tpl>
    <button class="drift-wall__tile" type="button">
      <span class="drift-wall__inner">
        <picture>
          <source type="image/webp" sizes={tileSizes} />
          <source type="image/jpeg" sizes={tileSizes} />
          <img
            alt=""
            loading="lazy"
            decoding="async"
            draggable="false"
            onload="this.classList.add('is-loaded')"
          />
          <span class="drift-wall__overlay" aria-hidden="true"></span>
        </picture>
      </span>
    </button>
  </template>

  <div class="container gallery__more">
    {deferredCount > 0 && (
      <button class="btn btn--ghost" type="button" data-wall-more>
        {site.gallery.loadMore}
        <span class="gallery__more-count">({deferredCount})</span>
      </button>
    )}
    <a
      class="btn"
      href={site.gallery.cta.href}
      data-track="cta"
      data-track-loc="gallery"
      data-track-label="packages"
    >
      {site.gallery.cta.label}
    </a>
  </div>

  <!-- Lightbox -->
  <div class="lb" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="גלריית תמונות">
    <button class="lb__close" data-lb-close aria-label="סגירה">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
    <button class="lb__nav lb__nav--prev" data-lb-prev aria-label="הקודם">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 6 15 12 9 18"/></svg>
    </button>
    <button class="lb__nav lb__nav--next" data-lb-next aria-label="הבא">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 6 9 12 15 18"/></svg>
    </button>
    <figure class="lb__stage" data-lb-stage>
      <picture>
        <source data-lb-webp type="image/webp" sizes="92vw" />
        <source data-lb-jpg type="image/jpeg" sizes="92vw" />
        <img class="lb__img" data-lb-img alt="" />
      </picture>
    </figure>
    <div class="lb__counter" data-lb-counter></div>
  </div>
</section>

<style>
  .gallery {
    background: var(--paper);
    overflow: hidden;
  }
  .gallery__head {
    text-align: center;
    max-width: 660px;
    margin-inline: auto;
    margin-block-end: clamp(1.8rem, 1rem + 2.4vw, 3.2rem);
  }
  .gallery__head .eyebrow { margin-block-end: 1.1rem; }
  .gallery__title {
    font-size: var(--fs-h2);
    margin-block-end: 1rem;
  }
  .gallery__subtitle {
    color: var(--ink-60);
    font-size: var(--fs-lead);
    font-weight: 300;
  }

  /* ---------------- DriftWall (vanilla port, warm-adapted) ---------------- */
  .drift-wall {
    position: relative;
    width: 100%;
    height: clamp(560px, 78vh, 820px);
    overflow: hidden;
    perspective: 1200px;
    perspective-origin: 50% 50%;
    /* config vars (warm-adapted). Tiles are 2:3 portrait to match the photos. */
    --dw-tile-w: 176px;
    --dw-tile-h: 264px;
    --dw-gap: 18px;
    --dw-radius: var(--radius);
    --dw-lift: 64px;
    --dw-dim: 1; /* tiles rest in full colour (hover just lifts them) */
    --dw-overlay: var(--espresso);
    --dw-edge: 60%; /* solid centre before the edge dissolve begins */
    /* Soft radial vignette so the wall dissolves into the page at every edge.
       A single-layer mask is used deliberately: multi-layer `mask-composite`
       renders inconsistently across browsers and blanked the whole wall. */
    -webkit-mask-image: radial-gradient(ellipse 84% 90% at 50% 45%, #000 var(--dw-edge), transparent 100%);
    mask-image: radial-gradient(ellipse 84% 90% at 50% 45%, #000 var(--dw-edge), transparent 100%);
  }

  .drift-wall__plane {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: row;
    transform-style: preserve-3d;
    transform-origin: 50% 50%;
    /* base transform (kept in sync with the JS constants) avoids first-paint flash */
    transform:
      translate(-50%, -50%) scale(1.18)
      rotateX(16deg) rotateY(-14deg) rotateZ(0deg) translateZ(-120px);
    will-change: transform;
    cursor: pointer;
  }

  .drift-wall__col {
    position: relative;
    width: calc(var(--dw-tile-w) + var(--dw-gap));
    transform-style: preserve-3d;
  }

  .drift-wall__track {
    display: flex;
    flex-direction: column;
    will-change: transform;
    transform-style: preserve-3d;
  }

  .drift-wall__tile {
    position: relative;
    display: block;
    width: 100%;
    height: calc(var(--dw-tile-h) + var(--dw-gap));
    flex: 0 0 auto;
    outline: none;
    transform-style: preserve-3d;
  }

  .drift-wall__inner {
    position: absolute;
    inset: calc(var(--dw-gap) / 2);
    display: block;
    border-radius: var(--dw-radius);
    overflow: hidden;
    background: var(--cream-2);
    opacity: var(--dw-dim);
    transform: translateZ(0);
    pointer-events: none;
    transition:
      transform 0.42s var(--ease),
      opacity 0.42s var(--ease),
      box-shadow 0.42s var(--ease);
  }
  .drift-wall__inner picture { display: block; width: 100%; height: 100%; }

  .drift-wall__tile img {
    width: 100%;
    height: 100%;
    /* Tiles are 2:3 portrait to match the photos (also 2:3), so cover fills
       each tile edge-to-edge while cropping the portrait majority essentially
       zero; only the few landscape shots trim at the sides. */
    object-fit: cover;
    background-size: cover;
    background-position: center;
    display: block;
    filter: saturate(1); /* full colour at rest */
    opacity: 0;
    transition: opacity 0.7s var(--ease), filter 0.42s var(--ease);
    user-select: none;
    -webkit-user-drag: none;
  }
  .drift-wall__tile img.is-loaded { opacity: 1; }

  .drift-wall__overlay {
    position: absolute;
    inset: 0;
    background: var(--dw-overlay);
    opacity: 0; /* no resting tint — tiles show their true colour */
    pointer-events: none;
    transition: opacity 0.42s var(--ease);
  }

  .drift-wall__tile.is-active .drift-wall__inner,
  .drift-wall__tile:focus-visible .drift-wall__inner {
    opacity: 1;
    transform: translateZ(var(--dw-lift));
    box-shadow: 0 24px 60px -18px rgba(32, 22, 16, 0.55);
  }
  .drift-wall__tile.is-active img,
  .drift-wall__tile:focus-visible img {
    filter: saturate(1.05);
  }
  .drift-wall__tile.is-active .drift-wall__overlay,
  .drift-wall__tile:focus-visible .drift-wall__overlay {
    opacity: 0;
  }
  .drift-wall__tile:focus-visible .drift-wall__inner {
    box-shadow:
      0 24px 60px -18px rgba(32, 22, 16, 0.55),
      0 0 0 2px var(--chestnut);
  }

  /* "More photos" — sits under the wall, disappears once everything is in. */
  .gallery__more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
    margin-block-start: clamp(1.4rem, 0.8rem + 1.8vw, 2.4rem);
  }
  .gallery__more [hidden] { display: none; }
  .gallery__more-count {
    margin-inline-start: 0.45rem;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
  .gallery__more button[aria-busy="true"] {
    opacity: 0.6;
    pointer-events: none;
  }

  /* Responsive: fewer/smaller columns on narrow screens */
  @media (max-width: 1100px) {
    .drift-wall { --dw-tile-w: 160px; --dw-tile-h: 240px; --dw-gap: 14px; }
    /* hide the two outermost columns → 3 visible */
    .drift-wall__col:nth-child(n + 4) { display: none; }
  }
  @media (max-width: 720px) {
    .drift-wall {
      /* Large 2:3 portrait tiles so the wall reads big and tap targets are generous */
      --dw-tile-w: 200px; --dw-tile-h: 300px; --dw-gap: 16px;
      --dw-lift: 48px;
      height: clamp(520px, 78vh, 720px);
      perspective: 1050px;
    }
    /* Flatter, closer, more head-on base transform (matches the mobile JS
       config) so the enlarged wall reads centred, not skewed off to one side. */
    .drift-wall__plane {
      transform:
        translate(-50%, -50%) scale(1.16)
        rotateX(9deg) rotateY(-5deg) rotateZ(0deg) translateZ(-64px);
    }
  }
  /* Phones: a shorter wall and no "more photos". The wall is the teaser; the
     page's job from here is to carry the couple on to the finder. */
  @media (max-width: 760px) {
    .drift-wall { height: clamp(420px, 60vh, 540px); }
    .gallery__more [data-wall-more] { display: none; }
  }
  @media (max-width: 520px) {
    .drift-wall { --dw-tile-w: 190px; --dw-tile-h: 285px; }
    /* 2 visible columns, centred */
    .drift-wall__col:nth-child(n + 3) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .drift-wall__plane,
    .drift-wall__track { will-change: auto; }
  }

  /* ---------------- Lightbox ---------------- */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(32, 22, 16, 0.94);
    backdrop-filter: blur(6px);
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  /* The [hidden] attribute must win over display:grid, otherwise the
     invisible overlay covers the page and swallows every click. */
  .lb[hidden] {
    display: none;
  }
  .lb.is-open { opacity: 1; }
  .lb__stage {
    max-width: min(92vw, 1500px);
    max-height: 86svh;
    display: grid;
    place-items: center;
  }
  .lb__img {
    max-width: 92vw;
    max-height: 86svh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .lb__img.is-ready { opacity: 1; }

  .lb__close,
  .lb__nav {
    position: absolute;
    z-index: 2;
    color: #fff;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    transition: background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .lb__close:hover,
  .lb__nav:hover { background: rgba(255, 255, 255, 0.2); }
  .lb__close {
    top: clamp(0.8rem, 2vw, 1.6rem);
    inset-inline-end: clamp(0.8rem, 2vw, 1.6rem);
  }
  .lb__nav { top: 50%; transform: translateY(-50%); }
  .lb__nav:hover { transform: translateY(-50%) scale(1.06); }
  /* RTL-aware placement: prev on the right, next on the left */
  .lb__nav--prev { inset-inline-end: clamp(0.6rem, 2vw, 1.8rem); }
  .lb__nav--next { inset-inline-start: clamp(0.6rem, 2vw, 1.8rem); }

  .lb__counter {
    position: absolute;
    inset-block-end: clamp(0.9rem, 2.5vw, 1.8rem);
    inset-inline: 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-label);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    direction: ltr;
  }
  @media (max-width: 620px) {
    .lb__nav { width: 44px; height: 44px; }
  }
</style>

<script>
  // ===================== DriftWall drift engine (vanilla) =====================
  // Ported from the React Bits DriftWall component: a 3D-tilted plane of
  // vertical columns that drift continuously, lean toward the pointer, and lift
  // a hovered tile. No React — refs held in closures, class toggles for state.
  // The document ships ONE stack per column; these are the clones that make the
  // drift loop seamless. Cloning costs no markup, so the copies are built here
  // instead of being repeated three times in the HTML.
  const COPIES = 3;
  const COLUMNS = 5;
  const TILE_SIZES = "220px";

  // Config (kept in sync with the CSS base transform on .drift-wall__plane).
  const CFG = {
    tilt: 16,
    turn: -14,
    roll: 0,
    depth: 120,
    scale: 1.18,
    speed: 42,
    direction: "up", // "up" | "down"
    variance: 0.45,
    parallax: 0.6,
    pauseOnHover: false,
  };

  const wall = document.querySelector("[data-wall]");
  const plane = wall?.querySelector("[data-plane]");
  const tracks = wall ? Array.from(wall.querySelectorAll("[data-track]")) : [];
  const tileTpl = document.querySelector("[data-tile-tpl]");
  const moreBtn = document.querySelector("[data-wall-more]");

  // The per-column base stack (copy 0) as rendered by the server. Everything
  // else in a track is a clone of this, so growing the wall means growing the
  // base stack and rebuilding the clones.
  const baseStacks = tracks.map((track) => Array.from(track.children));

  // Stamp each clone with its own copy index so [data-tile-id] stays unique.
  const buildCopies = () => {
    tracks.forEach((track, c) => {
      const base = baseStacks[c];
      // Drop everything after the base stack, then re-clone.
      while (track.children.length > base.length) track.lastElementChild.remove();
      for (let copy = 1; copy < COPIES; copy++) {
        const frag = document.createDocumentFragment();
        base.forEach((tile) => {
          const clone = tile.cloneNode(true);
          const id = clone.getAttribute("data-tile-id");
          if (id) clone.setAttribute("data-tile-id", id.replace(/^(\d+)-\d+-/, `$1-${copy}-`));
          frag.appendChild(clone);
        });
        track.appendChild(frag);
      }
    });
  };

  // ---- Photo payload (tiles beyond INITIAL + every lightbox source) ----
  // Moved out of the HTML into /gallery-wall.json so the homepage does not
  // carry ~15KB of srcset strings that most visitors never need.
  let data = [];
  let dataPromise = null;
  const ensureData = () => {
    if (!dataPromise) {
      dataPromise = fetch("/gallery-wall.json")
        .then((r) => (r.ok ? r.json() : { items: [] }))
        .then((j) => {
          data = j.items || [];
          return data;
        })
        .catch(() => {
          dataPromise = null; // let a later tap retry
          return [];
        });
    }
    return dataPromise;
  };

  // Warm the payload when the wall comes into view, so the first tap on a tile
  // opens the lightbox without waiting on the network.
  if (wall && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          ensureData();
        }
      },
      { rootMargin: "300px" }
    );
    io.observe(wall);
  }

  // Build a tile for a deferred photo by cloning the server-rendered template,
  // which carries Astro's scoped-style attributes.
  const makeTile = (entry, col) => {
    const tile = tileTpl.content.firstElementChild.cloneNode(true);
    tile.setAttribute("data-open", String(entry.i));
    tile.setAttribute("data-col", String(col));
    tile.setAttribute("data-tile-id", `${col}-0-${entry.i}`);
    tile.setAttribute("aria-label", `הגדלת תמונה ${entry.i + 1}`);
    const [webp, jpg] = tile.querySelectorAll("source");
    webp.setAttribute("srcset", entry.webp);
    webp.setAttribute("sizes", TILE_SIZES);
    jpg.setAttribute("srcset", entry.jpg);
    jpg.setAttribute("sizes", TILE_SIZES);
    const img = tile.querySelector("img");
    img.setAttribute("src", entry.tile);
    img.setAttribute("alt", `רגע מתוך יום החתונה - ${entry.i + 1}`);
    img.setAttribute("width", String(entry.w));
    img.setAttribute("height", String(entry.h));
    if (entry.lqip) img.style.backgroundImage = `url('${entry.lqip}')`;
    return tile;
  };

  buildCopies();

  const reduced =
    typeof window !== "undefined" &&
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Per-column speed variation (verbatim from the source).
  const columnFactor = (index, variance) => {
    const pseudo = ((index * 0.6180339887 + 0.35) % 1) * 2 - 1;
    return 1 + variance * pseudo;
  };

  // On phones the wall is enlarged (~2x tiles); pair that with a flatter,
  // closer, calmer 3D so it reads bigger, sits centred head-on rather than
  // skewed, and is easier to tap. Full cinematic tilt on larger screens.
  const applyConfig = () => {
    const mobile = window.matchMedia("(max-width: 720px)").matches;
    Object.assign(
      CFG,
      mobile
        ? { tilt: 9, turn: -5, depth: 64, scale: 1.16, parallax: 0.35, speed: 26 }
        : { tilt: 16, turn: -14, depth: 120, scale: 1.18, parallax: 0.6, speed: 42 }
    );
  };
  applyConfig();

  let baseVelocities = [];
  const computeVelocities = () => {
    const dirSign = CFG.direction === "up" ? 1 : -1;
    baseVelocities = tracks.map((_, c) => {
      const altSign = c % 2 === 0 ? 1 : -1;
      return CFG.speed * columnFactor(c, CFG.variance) * dirSign * altSign;
    });
  };
  computeVelocities();

  // Per-column geometry, remeasured on resize (handles responsive tile sizes).
  let copyHeights = [];
  const measure = () => {
    copyHeights = tracks.map((track) => {
      // One copy's LAYOUT height. offsetHeight is used deliberately, NOT
      // getBoundingClientRect: the latter returns the 3D-transformed screen
      // height (perspective/rotateY foreshortening), which differs per column
      // and would desync the modulo wrap from the local-space translate — the
      // track would jump at every wrap and briefly show a gap. offsetHeight is
      // the untransformed height, so wrapping at exactly one copy is seamless.
      // Hidden columns (display:none on mobile) report 0 and are skipped.
      return track.children.length ? track.offsetHeight / COPIES : 0;
    });
  };

  const offsets = tracks.map((_, c) => c * 0.37); // fractional seeds; scaled after measure
  const velocities = tracks.map(() => 0);

  const applyPlaneTransform = (px, py) => {
    if (!plane) return;
    plane.style.transform =
      `translate(-50%, -50%) scale(${CFG.scale}) ` +
      `rotateX(${CFG.tilt + py}deg) rotateY(${CFG.turn + px}deg) rotateZ(${CFG.roll}deg) ` +
      `translateZ(${-CFG.depth}px)`;
  };

  // Pointer + hover state.
  const pointer = { x: 0, y: 0 };
  const pointerDamped = { x: 0, y: 0 };
  let hoveredCol = -1;
  let wallHovered = false;
  let activeTile = null;

  const setActive = (tile) => {
    if (activeTile === tile) return;
    activeTile?.classList.remove("is-active");
    activeTile = tile;
    activeTile?.classList.add("is-active");
    hoveredCol = tile ? Number(tile.dataset.col) : -1;
  };

  // Resolve the tile at a screen point. document.elementFromPoint is unreliable
  // inside a `transform-style: preserve-3d` subtree: it intermittently returns
  // an ancestor (plane/track/col) instead of the tile that is actually there,
  // which broke hover activation and made taps fail to open the lightbox. The
  // full elementsFromPoint stack always contains the tile, so search that.
  const tileAtPoint = (x, y) => {
    for (const el of document.elementsFromPoint(x, y)) {
      const t = el.matches?.("[data-tile-id]") ? el : el.closest?.("[data-tile-id]");
      if (t && wall.contains(t)) return t;
    }
    return null;
  };

  const onPointerMove = (e) => {
    const rect = wall?.getBoundingClientRect();
    if (!rect) return;
    if (CFG.parallax > 0 && !reduced) {
      pointer.x = (e.clientX - rect.left) / rect.width - 0.5;
      pointer.y = (e.clientY - rect.top) / rect.height - 0.5;
    }
    const tile = tileAtPoint(e.clientX, e.clientY);
    // Hysteresis: only switch when the pointer positively lands on a tile.
    // Falling on a gap between tiles keeps the current one active, so a lifted
    // tile never flickers on/off as the column glides to a halt. The active
    // tile is cleared on pointerleave (or blur), not on every gap.
    if (tile) setActive(tile);
  };

  const onPointerLeave = () => {
    wallHovered = false;
    pointer.x = 0;
    pointer.y = 0;
    setActive(null);
  };

  // Freeze the pressed column the instant a press starts, so the tile can't
  // drift out from under the pointer between pointerdown and pointerup — that
  // drift is what suppressed the click event and left some tiles unopenable.
  const onPointerDown = (e) => {
    const tile = tileAtPoint(e.clientX, e.clientY);
    if (tile) setActive(tile);
  };

  if (wall) {
    wall.addEventListener("pointermove", onPointerMove);
    wall.addEventListener("pointerdown", onPointerDown);
    wall.addEventListener("pointerenter", () => (wallHovered = true));
    wall.addEventListener("pointerleave", onPointerLeave);
    // Keyboard focus should also light a tile up. Delegated rather than bound
    // per tile, so tiles cloned for the loop or added by "עוד תמונות" are
    // covered without rebinding.
    wall.addEventListener("focusin", (e) => {
      const tile = e.target.closest?.("[data-tile-id]");
      if (tile) setActive(tile);
    });
    wall.addEventListener("focusout", () => setActive(null));
    window.addEventListener("resize", () => {
      applyConfig();
      computeVelocities();
      measure();
    });
  }

  measure();
  // Seed offsets within a copy height now that geometry is known.
  tracks.forEach((_, c) => {
    offsets[c] = (copyHeights[c] || 0) * (offsets[c] % 1);
  });

  // ---- "עוד תמונות": append the photos the document did not ship ----
  let loading = false;
  let loaded = false;
  const loadMore = async () => {
    // `loading` guards the await below: without it a second tap that lands
    // before the fetch resolves would append every deferred photo twice.
    if (loading || loaded || !moreBtn) return;
    loading = true;
    moreBtn.setAttribute("aria-busy", "true");
    const all = await ensureData();
    const shown = new Set(
      baseStacks.flat().map((t) => Number(t.getAttribute("data-open")))
    );
    const extra = all.filter((entry) => !shown.has(entry.i));
    if (!extra.length) {
      loading = false;
      moreBtn.removeAttribute("aria-busy");
      return;
    }

    // Keep each column's drift phase across the rebuild: remember where the
    // track sits as a fraction of one copy, then restore it against the new
    // (taller) copy height, so the wall grows without jumping.
    const phases = copyHeights.map((h, c) => (h ? offsets[c] / h : 0));

    extra.forEach((entry) => {
      const col = entry.i % COLUMNS;
      const track = tracks[col];
      if (!track) return;
      const tile = makeTile(entry, col);
      baseStacks[col].push(tile);
      track.insertBefore(tile, track.children[baseStacks[col].length - 1] || null);
    });

    buildCopies();
    loaded = true;
    loading = false;
    measure();
    tracks.forEach((_, c) => {
      offsets[c] = (copyHeights[c] || 0) * phases[c];
    });

    moreBtn.removeAttribute("aria-busy");
    moreBtn.setAttribute("hidden", "");
  };
  moreBtn?.addEventListener("click", loadMore);

  let raf = null;
  let lastTs = null;

  const animate = (ts) => {
    if (lastTs === null) lastTs = ts;
    const dt = Math.min(0.05, Math.max(0, ts - lastTs) / 1000);
    lastTs = ts;

    // Pointer-damped parallax lean.
    const maxTilt = CFG.parallax * 8;
    const targetX = pointer.x * maxTilt;
    const targetY = -pointer.y * maxTilt;
    const damp = 1 - Math.exp(-dt / 0.12);
    pointerDamped.x += (targetX - pointerDamped.x) * damp;
    pointerDamped.y += (targetY - pointerDamped.y) * damp;
    applyPlaneTransform(pointerDamped.x, pointerDamped.y);

    // Per-column drift.
    for (let c = 0; c < tracks.length; c++) {
      const copyH = copyHeights[c];
      if (!copyH) continue;
      const frozen = (wallHovered && CFG.pauseOnHover) || hoveredCol === c;
      if (frozen) {
        // Halt the hovered column at once so the tile stays locked under the
        // pointer (no glide-to-stop that would shift it out from the cursor).
        velocities[c] = 0;
        tracks[c].style.transform = `translate3d(0, ${-offsets[c]}px, 0)`;
        continue;
      }
      // Ease velocity back up to the base drift when released.
      const ease = 1 - Math.exp(-dt / 0.28);
      velocities[c] += (baseVelocities[c] - velocities[c]) * ease;
      let next = offsets[c] + velocities[c] * dt;
      next = ((next % copyH) + copyH) % copyH;
      offsets[c] = next;
      tracks[c].style.transform = `translate3d(0, ${-next}px, 0)`;
    }

    raf = requestAnimationFrame(animate);
  };

  if (wall && !reduced) {
    raf = requestAnimationFrame(animate);
  } else {
    // Reduced motion: static plane + static offsets, hover lift still works.
    applyPlaneTransform(0, 0);
    tracks.forEach((track, c) => {
      track.style.transform = `translate3d(0, ${-(offsets[c] || 0)}px, 0)`;
    });
  }

  // ===================== Lightbox (unchanged behaviour) =====================
  // `data` is filled by ensureData() from /gallery-wall.json; it is warmed as
  // soon as the wall scrolls into view, so a tap almost never waits on it.
  const lb = document.querySelector("[data-lightbox]");
  const lbImg = lb?.querySelector("[data-lb-img]");
  const lbWebp = lb?.querySelector("[data-lb-webp]");
  const lbJpg = lb?.querySelector("[data-lb-jpg]");
  const counter = lb?.querySelector("[data-lb-counter]");
  let current = 0;
  let lastFocus = null;

  const show = (idx) => {
    if (!data.length) return;
    current = ((idx % data.length) + data.length) % data.length;
    const d = data[current];
    lbImg.classList.remove("is-ready");
    const img = new Image();
    img.onload = () => {
      // sizes must be set on each <source>; a sizes on the <img> does not
      // apply to them.
      lbWebp.srcset = d.webp;
      lbJpg.srcset = d.jpg;
      lbImg.src = d.src;
      lbImg.sizes = "92vw";
      lbImg.width = d.w;
      lbImg.height = d.h;
      lbImg.classList.add("is-ready");
    };
    img.src = d.src;
    counter.textContent = `${current + 1} / ${data.length}`;
    // Preload neighbours
    [current + 1, current - 1].forEach((n) => {
      const nn = (n + data.length) % data.length;
      new Image().src = data[nn].src;
    });
  };

  const open = async (idx) => {
    // The sources live in /gallery-wall.json now; it is normally already warm
    // (fetched when the wall scrolled into view), so this resolves instantly.
    if (!data.length) await ensureData();
    if (!data.length) return;
    lastFocus = document.activeElement;
    lb.hidden = false;
    lb.setAttribute("aria-hidden", "false");
    requestAnimationFrame(() => lb.classList.add("is-open"));
    document.body.style.overflow = "hidden";
    show(idx);
    lb.querySelector("[data-lb-close]")?.focus();
  };
  const close = () => {
    lb.classList.remove("is-open");
    lb.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    setTimeout(() => {
      lb.hidden = true;
      lbImg.removeAttribute("src");
    }, 320);
    // Touch devices have no pointerleave — clear the lifted/paused tile so the
    // wall resumes drifting after the lightbox closes.
    setActive(null);
    lastFocus?.focus?.();
  };
  const next = () => show(current + 1);
  const prev = () => show(current - 1);

  // Open via a single wall-level handler instead of per-tile click listeners
  // (a per-tile listener only fires when pointerdown and pointerup land on the
  // same element, which fails on a drifting tile). Prefer the active/lifted
  // tile, but fall back to hit-testing at the click point so a tap still opens
  // even when no tile was pre-activated (e.g. pointerdown landed on a gap).
  wall?.addEventListener("click", (e) => {
    const tile = activeTile || tileAtPoint(e.clientX, e.clientY);
    if (tile) open(Number(tile.getAttribute("data-open")));
  });
  lb?.querySelector("[data-lb-close]")?.addEventListener("click", close);
  lb?.querySelector("[data-lb-next]")?.addEventListener("click", next);
  lb?.querySelector("[data-lb-prev]")?.addEventListener("click", prev);
  lb?.addEventListener("click", (e) => {
    if (e.target === lb || e.target.classList.contains("lb__stage")) close();
  });

  document.addEventListener("keydown", (e) => {
    if (lb.hidden) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowLeft") next(); // RTL: left = forward
    else if (e.key === "ArrowRight") prev();
  });

  // Touch swipe
  let tx = 0;
  lb?.addEventListener("touchstart", (e) => (tx = e.touches[0].clientX), { passive: true });
  lb?.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - tx;
    if (Math.abs(dx) > 45) (dx < 0 ? prev : next)(); // RTL swipe
  }, { passive: true });
</script>
