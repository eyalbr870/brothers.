---
import site from "@/data/site.js";
import manifest from "@/data/gallery.generated.json";
import { srcset, fallbackSrc, largestSrc, aspect } from "@/lib/images.js";

const items = manifest.items;
const INITIAL = 30; // show first N, "load more" reveals the rest

// Lightweight data the client lightbox needs (full-size sources).
const lightboxData = items.map((it, i) => ({
  i,
  webp: srcset(it, "webp"),
  jpg: srcset(it, "jpg"),
  src: largestSrc(it, "jpg"),
  w: it.width,
  h: it.height,
}));

const gridSizes =
  "(max-width: 560px) 46vw, (max-width: 900px) 31vw, (max-width: 1320px) 23vw, 300px";
---

<section class="gallery section" id="gallery">
  <div class="container">
    <header class="gallery__head">
      <p class="eyebrow" data-reveal>{site.gallery.eyebrow}</p>
      <h2 class="gallery__title" data-reveal>{site.gallery.title}</h2>
      <p class="gallery__subtitle" data-reveal>{site.gallery.subtitle}</p>
    </header>

    <div class="gallery__grid" data-grid>
      {items.map((it, i) => (
        <figure
          class="gallery__item"
          data-item
          data-index={i}
          hidden={i >= INITIAL}
          style={`--ratio:${aspect(it)}`}
        >
          <button
            class="gallery__btn"
            type="button"
            data-open={i}
            aria-label={`הגדלת תמונה ${i + 1}`}
          >
            <picture>
              <source type="image/webp" srcset={srcset(it, "webp")} sizes={gridSizes} />
              <source type="image/jpeg" srcset={srcset(it, "jpg")} sizes={gridSizes} />
              <img
                src={fallbackSrc(it, "jpg")}
                alt={`רגע מתוך יום החתונה — ${i + 1}`}
                width={it.width}
                height={it.height}
                loading="lazy"
                decoding="async"
                style={`background-image:url('${it.lqip}')`}
                onload="this.classList.add('is-loaded')"
              />
            </picture>
            <span class="gallery__zoom" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </span>
          </button>
        </figure>
      ))}
    </div>

    {items.length > INITIAL && (
      <div class="gallery__more">
        <button class="btn btn--ghost" type="button" data-loadmore>
          {site.gallery.loadMore}
        </button>
      </div>
    )}
  </div>

  <!-- Lightbox -->
  <div class="lb" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="גלריית תמונות">
    <button class="lb__close" data-lb-close aria-label="סגירה">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
    <button class="lb__nav lb__nav--prev" data-lb-prev aria-label="הקודם">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 6 15 12 9 18"/></svg>
    </button>
    <button class="lb__nav lb__nav--next" data-lb-next aria-label="הבא">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 6 9 12 15 18"/></svg>
    </button>
    <figure class="lb__stage" data-lb-stage>
      <img class="lb__img" data-lb-img alt="" />
    </figure>
    <div class="lb__counter" data-lb-counter></div>
  </div>

  <script type="application/json" data-lb-data set:html={JSON.stringify(lightboxData)}></script>
</section>

<style>
  .gallery {
    background: var(--paper);
  }
  .gallery__head {
    text-align: center;
    max-width: 660px;
    margin-inline: auto;
    margin-block-end: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .gallery__head .eyebrow { margin-block-end: 1.1rem; }
  .gallery__title {
    font-size: var(--fs-h2);
    margin-block-end: 1rem;
  }
  .gallery__subtitle {
    color: var(--ink-60);
    font-size: var(--fs-lead);
    font-weight: 300;
  }

  /* Masonry via CSS columns */
  .gallery__grid {
    column-count: 4;
    column-gap: clamp(0.6rem, 0.3rem + 0.9vw, 1.15rem);
  }
  @media (max-width: 1100px) { .gallery__grid { column-count: 3; } }
  @media (max-width: 720px) { .gallery__grid { column-count: 2; } }

  .gallery__item {
    break-inside: avoid;
    margin-block-end: clamp(0.6rem, 0.3rem + 0.9vw, 1.15rem);
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s var(--ease), transform 0.8s var(--ease);
  }
  .gallery__item.is-in { opacity: 1; transform: none; }

  .gallery__btn {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--cream-2);
    border-radius: var(--radius);
  }
  .gallery__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.7s var(--ease), transform 1.2s var(--ease);
  }
  .gallery__btn img.is-loaded { opacity: 1; }
  .gallery__btn:hover img { transform: scale(1.05); }

  .gallery__zoom {
    position: absolute;
    inset-block-end: 0.7rem;
    inset-inline-end: 0.7rem;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(69, 50, 38, 0.55);
    border-radius: 50%;
    backdrop-filter: blur(3px);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .gallery__btn:hover .gallery__zoom,
  .gallery__btn:focus-visible .gallery__zoom {
    opacity: 1;
    transform: none;
  }

  .gallery__more {
    text-align: center;
    margin-block-start: clamp(2rem, 1.2rem + 2vw, 3.5rem);
  }

  /* ---------------- Lightbox ---------------- */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(32, 22, 16, 0.94);
    backdrop-filter: blur(6px);
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  /* The [hidden] attribute must win over display:grid, otherwise the
     invisible overlay covers the page and swallows every click. */
  .lb[hidden] {
    display: none;
  }
  .lb.is-open { opacity: 1; }
  .lb__stage {
    max-width: min(92vw, 1500px);
    max-height: 86svh;
    display: grid;
    place-items: center;
  }
  .lb__img {
    max-width: 92vw;
    max-height: 86svh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .lb__img.is-ready { opacity: 1; }

  .lb__close,
  .lb__nav {
    position: absolute;
    z-index: 2;
    color: #fff;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    transition: background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .lb__close:hover,
  .lb__nav:hover { background: rgba(255, 255, 255, 0.2); }
  .lb__close {
    top: clamp(0.8rem, 2vw, 1.6rem);
    inset-inline-end: clamp(0.8rem, 2vw, 1.6rem);
  }
  .lb__nav { top: 50%; transform: translateY(-50%); }
  .lb__nav:hover { transform: translateY(-50%) scale(1.06); }
  /* RTL-aware placement: prev on the right, next on the left */
  .lb__nav--prev { inset-inline-end: clamp(0.6rem, 2vw, 1.8rem); }
  .lb__nav--next { inset-inline-start: clamp(0.6rem, 2vw, 1.8rem); }

  .lb__counter {
    position: absolute;
    inset-block-end: clamp(0.9rem, 2.5vw, 1.8rem);
    inset-inline: 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-label);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    direction: ltr;
  }
  @media (max-width: 620px) {
    .lb__nav { width: 44px; height: 44px; }
  }
</style>

<script>
  // ---- Grid reveal (staggered) + load more ----
  const grid = document.querySelector("[data-grid]");
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: "0px 0px -8% 0px" }
  );
  const observeVisible = () =>
    grid?.querySelectorAll("[data-item]:not([hidden])").forEach((el) => io.observe(el));
  observeVisible();

  const loadMore = document.querySelector("[data-loadmore]");
  loadMore?.addEventListener("click", () => {
    grid?.querySelectorAll("[data-item][hidden]").forEach((el) => el.removeAttribute("hidden"));
    observeVisible();
    loadMore.remove();
  });

  // ---- Lightbox ----
  const data = JSON.parse(
    document.querySelector("[data-lb-data]")?.textContent || "[]"
  );
  const lb = document.querySelector("[data-lightbox]");
  const lbImg = lb?.querySelector("[data-lb-img]");
  const counter = lb?.querySelector("[data-lb-counter]");
  let current = 0;
  let lastFocus = null;

  const show = (idx) => {
    current = (idx + data.length) % data.length;
    const d = data[current];
    lbImg.classList.remove("is-ready");
    const img = new Image();
    img.onload = () => {
      lbImg.src = d.src;
      lbImg.srcset = d.jpg;
      lbImg.sizes = "92vw";
      lbImg.width = d.w;
      lbImg.height = d.h;
      lbImg.classList.add("is-ready");
    };
    img.src = d.src;
    counter.textContent = `${current + 1} / ${data.length}`;
    // Preload neighbours
    [current + 1, current - 1].forEach((n) => {
      const nn = (n + data.length) % data.length;
      new Image().src = data[nn].src;
    });
  };

  const open = (idx) => {
    lastFocus = document.activeElement;
    lb.hidden = false;
    lb.setAttribute("aria-hidden", "false");
    requestAnimationFrame(() => lb.classList.add("is-open"));
    document.body.style.overflow = "hidden";
    show(idx);
    lb.querySelector("[data-lb-close]")?.focus();
  };
  const close = () => {
    lb.classList.remove("is-open");
    lb.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    setTimeout(() => {
      lb.hidden = true;
      lbImg.removeAttribute("src");
    }, 320);
    lastFocus?.focus?.();
  };
  const next = () => show(current + 1);
  const prev = () => show(current - 1);

  document.querySelectorAll("[data-open]").forEach((btn) =>
    btn.addEventListener("click", () => open(Number(btn.getAttribute("data-open"))))
  );
  lb?.querySelector("[data-lb-close]")?.addEventListener("click", close);
  lb?.querySelector("[data-lb-next]")?.addEventListener("click", next);
  lb?.querySelector("[data-lb-prev]")?.addEventListener("click", prev);
  lb?.addEventListener("click", (e) => {
    if (e.target === lb || e.target.classList.contains("lb__stage")) close();
  });

  document.addEventListener("keydown", (e) => {
    if (lb.hidden) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowLeft") next(); // RTL: left = forward
    else if (e.key === "ArrowRight") prev();
  });

  // Touch swipe
  let tx = 0;
  lb?.addEventListener("touchstart", (e) => (tx = e.touches[0].clientX), { passive: true });
  lb?.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - tx;
    if (Math.abs(dx) > 45) (dx < 0 ? prev : next)(); // RTL swipe
  }, { passive: true });
</script>
