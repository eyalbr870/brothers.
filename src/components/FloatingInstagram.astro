---
import site from "@/data/site.js";
const ig = site.contact.instagramUrl;
---

<a
  class="fab-ig"
  href={ig}
  target="_blank"
  rel="noopener"
  aria-label="לעמוד האינסטגרם שלנו"
>
  <span class="fab-ig__label">עקבו אחרינו</span>
  <span class="fab-ig__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
      <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 1.44c-3.14 0-3.51.01-4.75.07-1.15.05-1.77.24-2.19.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.42-.35 1.04-.4 2.19-.06 1.24-.07 1.61-.07 4.75s.01 3.51.07 4.75c.05 1.15.24 1.77.4 2.19.21.55.47.94.88 1.35.41.41.8.67 1.35.88.42.16 1.04.35 2.19.4 1.24.06 1.61.07 4.75.07s3.51-.01 4.75-.07c1.15-.05 1.77-.24 2.19-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.42.35-1.04.4-2.19.06-1.24.07-1.61.07-4.75s-.01-3.51-.07-4.75c-.05-1.15-.24-1.77-.4-2.19a3.65 3.65 0 00-.88-1.35 3.65 3.65 0 00-1.35-.88c-.42-.16-1.04-.35-2.19-.4-1.24-.06-1.61-.07-4.75-.07zm0 3.68a4.72 4.72 0 100 9.44 4.72 4.72 0 000-9.44zm0 7.79a3.07 3.07 0 110-6.14 3.07 3.07 0 010 6.14zm6.01-7.97a1.1 1.1 0 11-2.2 0 1.1 1.1 0 012.2 0z"></path>
    </svg>
  </span>
</a>

<style>
  .fab-ig {
    position: fixed;
    /* stacked directly above the WhatsApp bubble (60px tall) with a small gap */
    inset-block-end: calc(clamp(1.1rem, 0.6rem + 1.5vw, 1.9rem) + 60px + 0.75rem);
    inset-inline-start: clamp(1.1rem, 0.6rem + 1.5vw, 1.9rem);
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0;
    height: 60px;
    padding: 0;
    border-radius: 100px;
    background: var(--mocha);
    color: var(--paper);
    box-shadow: 0 12px 30px -8px rgba(69, 50, 38, 0.55), 0 4px 10px -4px rgba(0, 0, 0, 0.25);
    transition: background 0.35s var(--ease), transform 0.45s var(--ease), box-shadow 0.35s var(--ease), opacity 0.45s var(--ease);
    /* hidden until scrolled past the hero (so it never covers the hero CTAs) */
    opacity: 0;
    transform: translateY(16px) scale(0.9);
    pointer-events: none;
    overflow: hidden;
  }
  /* slight stagger so the pair reveals one after the other */
  :global(html.fabs-revealed) .fab-ig {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition-delay: 0.08s;
  }

  .fab-ig:hover {
    background: var(--chestnut);
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -10px rgba(69, 50, 38, 0.6);
  }

  .fab-ig__icon {
    flex: none;
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    position: relative;
  }
  /* pulse ring */
  .fab-ig__icon::before {
    content: "";
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    border: 2px solid var(--sand);
    opacity: 0;
    animation: fabIgPulse 2.6s var(--ease) infinite;
  }
  @keyframes fabIgPulse {
    0% { transform: scale(0.85); opacity: 0.5; }
    70% { transform: scale(1.5); opacity: 0; }
    100% { opacity: 0; }
  }

  /* label expands on hover (desktop pointers only) */
  .fab-ig__label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    white-space: nowrap;
    max-width: 0;
    opacity: 0;
    padding-inline-start: 0;
    transition: max-width 0.4s var(--ease), opacity 0.35s var(--ease), padding 0.4s var(--ease);
  }
  @media (hover: hover) and (min-width: 700px) {
    .fab-ig:hover .fab-ig__label {
      max-width: 200px;
      opacity: 1;
      padding-inline-start: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab-ig { transition: none; }
    .fab-ig__icon::before { animation: none; }
  }
</style>

<script>
  // Reveal the floating bubbles only after the hero has scrolled mostly out of
  // view, so they can never overlap the hero CTA buttons at any viewport width.
  const root = document.documentElement;
  const hero = document.getElementById("hero");
  const update = () => {
    const show = !hero || hero.getBoundingClientRect().bottom < window.innerHeight * 0.55;
    root.classList.toggle("fabs-revealed", show);
  };
  update();
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update, { passive: true });
</script>
