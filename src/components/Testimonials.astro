---
import data from "@/data/reviews.json";

const INITIAL = 6;
const reviews = data.reviews;
const reviewUrl = data.source;
---

<section class="tst section" id="testimonials">
  <div class="container">
    <header class="tst__head">
      <p class="eyebrow" data-reveal>REVIEWS</p>
      <h2 class="tst__title" data-reveal>מה מספרים הזוגות</h2>

      <a
        class="tst__badge"
        href={reviewUrl}
        target="_blank"
        rel="noopener"
        data-reveal
        aria-label={`דירוג ${data.score} מתוך ${data.scoreMax} לפי ${data.count} ביקורות ב-mit4mit`}
      >
        <span class="tst__stars" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2.2l2.9 6.06 6.6.86-4.86 4.53 1.24 6.55L12 17.9l-5.88 3.3 1.24-6.55L2.5 9.12l6.6-.86L12 2.2z"/></svg>
          ))}
        </span>
        <span class="tst__score">{data.score}<span class="tst__score-max">/{data.scoreMax}</span></span>
        <span class="tst__badge-sep" aria-hidden="true"></span>
        <span class="tst__badge-text">
          <span class="tst__count">לפי {data.count} זוגות ב־</span>
          <img class="tst__logo" src="/logo/mit4mit.svg" alt="mit4mit" width="96" height="33" />
        </span>
      </a>
    </header>

    <div class="tst__grid" data-tst-grid>
      {reviews.map((r, i) => (
        <figure class="tcard" data-tst-item hidden={i >= INITIAL}>
          <div class="tcard__stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 24 24" width="15" height="15"><path fill="currentColor" d="M12 2.2l2.9 6.06 6.6.86-4.86 4.53 1.24 6.55L12 17.9l-5.88 3.3 1.24-6.55L2.5 9.12l6.6-.86L12 2.2z"/></svg>
            ))}
          </div>
          <blockquote class="tcard__text">{r.text}</blockquote>
          <figcaption class="tcard__meta">
            <span class="tcard__name">{r.name}</span>
            {r.date && <span class="tcard__date">{r.date}</span>}
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="tst__actions">
      {reviews.length > INITIAL && (
        <button class="btn btn--ghost" type="button" data-tst-more>עוד ביקורות</button>
      )}
      <a class="btn btn--ghost tst__all" href={reviewUrl} target="_blank" rel="noopener">
        לכל הביקורות ב־mit4mit
      </a>
    </div>
  </div>
</section>

<style>
  .tst {
    background: var(--cream);
  }
  .tst__head {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-block-end: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .tst__head .eyebrow { margin-block-end: 1.1rem; }
  .tst__title {
    font-size: var(--fs-h2);
    margin-block-end: 1.8rem;
  }

  /* Rating badge */
  .tst__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 1.35rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 100px;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .tst__badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -18px rgba(69, 50, 38, 0.5);
    border-color: var(--mocha);
  }
  .tst__stars { display: inline-flex; color: #c99a5b; gap: 1px; }
  .tst__score {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--espresso);
    line-height: 1;
    direction: ltr;
  }
  .tst__score-max { font-size: 0.9rem; color: var(--ink-45); font-weight: 500; }
  .tst__badge-sep {
    width: 1px;
    height: 26px;
    background: var(--line);
  }
  .tst__badge-text {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tst__count { font-size: 0.92rem; color: var(--ink-60); font-weight: 500; }
  .tst__logo { height: 22px; width: auto; display: block; }

  /* Cards — masonry */
  .tst__grid {
    column-count: 3;
    column-gap: clamp(0.9rem, 0.5rem + 1vw, 1.5rem);
  }
  @media (max-width: 1000px) { .tst__grid { column-count: 2; } }
  @media (max-width: 640px) { .tst__grid { column-count: 1; } }

  .tcard {
    break-inside: avoid;
    margin-block-end: clamp(0.9rem, 0.5rem + 1vw, 1.5rem);
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: 6px;
    padding: clamp(1.4rem, 1rem + 1vw, 2rem);
    box-shadow: 0 18px 40px -34px rgba(69, 50, 38, 0.5);
  }
  .tcard__stars {
    display: flex;
    gap: 2px;
    color: #c99a5b;
    margin-block-end: 0.9rem;
  }
  .tcard__text {
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--ink);
    font-weight: 400;
  }
  .tcard__text::before { content: "\201D"; }
  .tcard__text::after { content: "\201C"; }
  .tcard__meta {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-block-start: 1.2rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--line-soft);
  }
  .tcard__name {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.08rem;
    color: var(--espresso);
  }
  .tcard__date { font-size: 0.85rem; color: var(--ink-45); }

  .tst__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-block-start: clamp(2rem, 1.2rem + 2vw, 3.25rem);
  }
  .tst__all { direction: rtl; }

  @media (max-width: 460px) {
    .tst__badge { flex-wrap: wrap; justify-content: center; gap: 0.5rem 0.75rem; }
  }
</style>

<script>
  const grid = document.querySelector("[data-tst-grid]");
  const moreBtn = document.querySelector("[data-tst-more]");
  moreBtn?.addEventListener("click", () => {
    grid?.querySelectorAll("[data-tst-item][hidden]").forEach((el) => el.removeAttribute("hidden"));
    moreBtn.remove();
  });
</script>
