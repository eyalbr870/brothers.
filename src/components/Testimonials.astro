---
import data from "@/data/reviews.json";
import manifest from "@/data/review-photos.generated.json";

const INITIAL = 6;
const reviewUrl = data.source;

// Unified review cards: each review shows its text AND its attached photos.
// Reviewers who attached photos come from the generated manifest (their photos
// joined by reviewId); reviewers without photos come from the curated list.
const photoReviewers = Object.entries(manifest.reviews).map(([reviewId, r]) => ({
  name: r.name,
  text: r.text,
  date: r.date,
  photos: manifest.photos.filter((p) => p.reviewId === reviewId),
}));
const photoNames = new Set(photoReviewers.map((r) => r.name));
const textOnly = data.reviews
  .filter((r) => !photoNames.has(r.name))
  .map((r) => ({ name: r.name, text: r.text, date: r.date, photos: [] }));

// Photo cards first, then the remaining text-only reviews.
const cards = [...photoReviewers, ...textOnly];

// Per-card image sets (full-size) for the lightbox, indexed by card.
const galleries = cards.map((c) =>
  c.photos.map((p) => ({ src: p.full, w: p.w, h: p.h, name: p.name }))
);
---

<section class="tst section" id="testimonials">
  <div class="container">
    <header class="tst__head">
      <p class="eyebrow" data-reveal>REVIEWS</p>
      <h2 class="tst__title" data-reveal>מה מספרים הזוגות</h2>

      <a
        class="tst__badge"
        href={reviewUrl}
        target="_blank"
        rel="noopener"
        data-reveal
        aria-label={`דירוג ${data.score} מתוך ${data.scoreMax} לפי ${data.count} ביקורות ב-mit4mit`}
      >
        <span class="tst__stars" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2.2l2.9 6.06 6.6.86-4.86 4.53 1.24 6.55L12 17.9l-5.88 3.3 1.24-6.55L2.5 9.12l6.6-.86L12 2.2z"/></svg>
          ))}
        </span>
        <span class="tst__score">{data.score}<span class="tst__score-max">/{data.scoreMax}</span></span>
        <span class="tst__badge-sep" aria-hidden="true"></span>
        <span class="tst__badge-text">
          <span class="tst__count">לפי {data.count} זוגות ב־</span>
          <img class="tst__logo" src="/logo/mit4mit.svg" alt="mit4mit" width="96" height="33" />
        </span>
      </a>
    </header>

    <div class="tst__grid" data-tst-grid>
      {cards.map((r, i) => (
        <figure class="tcard" data-tst-item hidden={i >= INITIAL}>
          <div class="tcard__stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 24 24" width="15" height="15"><path fill="currentColor" d="M12 2.2l2.9 6.06 6.6.86-4.86 4.53 1.24 6.55L12 17.9l-5.88 3.3 1.24-6.55L2.5 9.12l6.6-.86L12 2.2z"/></svg>
            ))}
          </div>
          <blockquote class="tcard__text">{r.text}</blockquote>

          {r.photos.length > 0 && (
            <div class="tcard__photos" data-count={Math.min(r.photos.length, 6)}>
              {r.photos.slice(0, 6).map((p, pi) => (
                <button
                  class="tcard__photo"
                  type="button"
                  data-open-card={i}
                  data-open-idx={pi}
                  aria-label={`הגדלת תמונה ${pi + 1} מהביקורת של ${r.name}`}
                >
                  <img
                    src={p.card}
                    alt={`תמונה מהחתונה, ${r.name}`}
                    width={p.w}
                    height={p.h}
                    loading="lazy"
                    decoding="async"
                    style={p.lqip ? `background-image:url('${p.lqip}');background-size:cover` : undefined}
                  />
                  {pi === 5 && r.photos.length > 6 && (
                    <span class="tcard__photo-more">+{r.photos.length - 6}</span>
                  )}
                </button>
              ))}
            </div>
          )}

          <figcaption class="tcard__meta">
            <span class="tcard__name">{r.name}</span>
            {r.date && <span class="tcard__date">{r.date}</span>}
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="tst__actions">
      {cards.length > INITIAL && (
        <button class="btn btn--ghost" type="button" data-tst-more>עוד ביקורות</button>
      )}
      <a class="btn btn--ghost tst__all" href={reviewUrl} target="_blank" rel="noopener">
        לכל הביקורות ב־mit4mit
      </a>
    </div>
  </div>

  {galleries.some((g) => g.length > 0) && (
    <div class="rlb" data-rlb hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="תמונות מהביקורות">
      <button class="rlb__close" data-rlb-close aria-label="סגירה">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
      </button>
      <button class="rlb__nav rlb__nav--prev" data-rlb-prev aria-label="הקודם">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 6 15 12 9 18"/></svg>
      </button>
      <button class="rlb__nav rlb__nav--next" data-rlb-next aria-label="הבא">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 6 9 12 15 18"/></svg>
      </button>
      <figure class="rlb__stage" data-rlb-stage>
        <img class="rlb__img" data-rlb-img alt="" />
        <figcaption class="rlb__cap" data-rlb-cap></figcaption>
      </figure>
      <div class="rlb__counter" data-rlb-counter></div>
    </div>
    <script type="application/json" data-rlb-data set:html={JSON.stringify(galleries)}></script>
  )}
</section>

<style>
  .tst {
    background: var(--cream);
  }
  .tst__head {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-block-end: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .tst__head .eyebrow { margin-block-end: 1.1rem; }
  .tst__title {
    font-size: var(--fs-h2);
    margin-block-end: 1.8rem;
  }

  /* Rating badge */
  .tst__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 1.35rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 100px;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .tst__badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -18px rgba(69, 50, 38, 0.5);
    border-color: var(--mocha);
  }
  .tst__stars { display: inline-flex; color: #c99a5b; gap: 1px; }
  .tst__score {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--espresso);
    line-height: 1;
    direction: ltr;
  }
  .tst__score-max { font-size: 0.9rem; color: var(--ink-45); font-weight: 500; }
  .tst__badge-sep {
    width: 1px;
    height: 26px;
    background: var(--line);
  }
  .tst__badge-text {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tst__count { font-size: 0.92rem; color: var(--ink-60); font-weight: 500; }
  .tst__logo { height: 22px; width: auto; display: block; }

  /* Cards - masonry */
  .tst__grid {
    column-count: 3;
    column-gap: clamp(0.9rem, 0.5rem + 1vw, 1.5rem);
  }
  @media (max-width: 1000px) { .tst__grid { column-count: 2; } }
  @media (max-width: 640px) { .tst__grid { column-count: 1; } }

  .tcard {
    break-inside: avoid;
    margin-block-end: clamp(0.9rem, 0.5rem + 1vw, 1.5rem);
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: 6px;
    padding: clamp(1.4rem, 1rem + 1vw, 2rem);
    box-shadow: 0 18px 40px -34px rgba(69, 50, 38, 0.5);
  }
  .tcard__stars {
    display: flex;
    gap: 2px;
    color: #c99a5b;
    margin-block-end: 0.9rem;
  }
  .tcard__text {
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--ink);
    font-weight: 400;
  }
  .tcard__text::before { content: "\201D"; }
  .tcard__text::after { content: "\201C"; }

  /* Attached photos inside the card */
  .tcard__photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-block-start: 1.2rem;
  }
  .tcard__photos[data-count="1"] { grid-template-columns: 1fr; }
  .tcard__photos[data-count="2"] { grid-template-columns: repeat(2, 1fr); }
  .tcard__photo {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 5px;
    aspect-ratio: 1;
    background: var(--cream-2);
    cursor: pointer;
  }
  .tcard__photos[data-count="1"] .tcard__photo { aspect-ratio: 4 / 3; }
  .tcard__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease);
  }
  .tcard__photo:hover img { transform: scale(1.06); }
  .tcard__photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(69, 50, 38, 0);
    transition: background 0.3s var(--ease);
  }
  .tcard__photo:hover::after { background: rgba(69, 50, 38, 0.12); }
  .tcard__photo-more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(38, 26, 18, 0.55);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.25rem;
    z-index: 1;
  }

  .tcard__meta {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-block-start: 1.2rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--line-soft);
  }
  .tcard__name {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.08rem;
    color: var(--espresso);
  }
  .tcard__date { font-size: 0.85rem; color: var(--ink-45); }

  .tst__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-block-start: clamp(2rem, 1.2rem + 2vw, 3.25rem);
  }
  .tst__all { direction: rtl; }

  @media (max-width: 460px) {
    .tst__badge { flex-wrap: wrap; justify-content: center; gap: 0.5rem 0.75rem; }
  }

  /* ---------------- Review lightbox ---------------- */
  .rlb {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(32, 22, 16, 0.94);
    backdrop-filter: blur(6px);
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .rlb[hidden] { display: none; }
  .rlb.is-open { opacity: 1; }
  .rlb__stage {
    max-width: min(92vw, 1100px);
    max-height: 86svh;
    display: grid;
    place-items: center;
    gap: 0.9rem;
  }
  .rlb__img {
    max-width: 92vw;
    max-height: 78svh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .rlb__img.is-ready { opacity: 1; }
  .rlb__cap {
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-head);
    font-size: 1.05rem;
    text-align: center;
  }
  .rlb__close,
  .rlb__nav {
    position: absolute;
    z-index: 2;
    color: #fff;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    transition: background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .rlb__close:hover,
  .rlb__nav:hover { background: rgba(255, 255, 255, 0.2); }
  .rlb__close {
    top: clamp(0.8rem, 2vw, 1.6rem);
    inset-inline-end: clamp(0.8rem, 2vw, 1.6rem);
  }
  .rlb__nav { top: 50%; transform: translateY(-50%); }
  .rlb__nav:hover { transform: translateY(-50%) scale(1.06); }
  .rlb__nav--prev { inset-inline-end: clamp(0.6rem, 2vw, 1.8rem); }
  .rlb__nav--next { inset-inline-start: clamp(0.6rem, 2vw, 1.8rem); }
  .rlb__counter {
    position: absolute;
    inset-block-end: clamp(0.9rem, 2.5vw, 1.8rem);
    inset-inline: 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-label);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    direction: ltr;
  }
  /* A single-image set hides the nav + counter chrome. */
  .rlb[data-single] .rlb__nav,
  .rlb[data-single] .rlb__counter { display: none; }
  @media (max-width: 620px) {
    .rlb__nav { width: 44px; height: 44px; }
  }
</style>

<script>
  const grid = document.querySelector("[data-tst-grid]");
  const moreBtn = document.querySelector("[data-tst-more]");
  moreBtn?.addEventListener("click", () => {
    grid?.querySelectorAll("[data-tst-item][hidden]").forEach((el) => el.removeAttribute("hidden"));
    moreBtn.remove();
  });

  // ---- Fullscreen lightbox, scoped to the photos of the clicked review ----
  const galleries = JSON.parse(document.querySelector("[data-rlb-data]")?.textContent || "[]");
  const lb = document.querySelector("[data-rlb]");
  if (lb && galleries.length) {
    const lbImg = lb.querySelector("[data-rlb-img]");
    const cap = lb.querySelector("[data-rlb-cap]");
    const counter = lb.querySelector("[data-rlb-counter]");
    let set = [];
    let current = 0;
    let lastFocus = null;

    const show = (idx) => {
      current = (idx + set.length) % set.length;
      const d = set[current];
      lbImg.classList.remove("is-ready");
      const img = new Image();
      img.onload = () => {
        lbImg.src = d.src;
        lbImg.width = d.w;
        lbImg.height = d.h;
        lbImg.classList.add("is-ready");
      };
      img.src = d.src;
      cap.textContent = d.name || "";
      counter.textContent = `${current + 1} / ${set.length}`;
      [current + 1, current - 1].forEach((k) => {
        new Image().src = set[(k + set.length) % set.length].src;
      });
    };
    const open = (cardIdx, photoIdx) => {
      set = galleries[cardIdx] || [];
      if (!set.length) return;
      lb.toggleAttribute("data-single", set.length < 2);
      lastFocus = document.activeElement;
      lb.hidden = false;
      lb.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => lb.classList.add("is-open"));
      document.body.style.overflow = "hidden";
      show(photoIdx);
      lb.querySelector("[data-rlb-close]")?.focus();
    };
    const close = () => {
      lb.classList.remove("is-open");
      lb.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      setTimeout(() => { lb.hidden = true; lbImg.removeAttribute("src"); }, 320);
      lastFocus?.focus?.();
    };
    const next = () => show(current + 1);
    const prev = () => show(current - 1);

    document.querySelectorAll("[data-open-card]").forEach((btn) =>
      btn.addEventListener("click", () =>
        open(Number(btn.getAttribute("data-open-card")), Number(btn.getAttribute("data-open-idx")))
      )
    );
    lb.querySelector("[data-rlb-close]")?.addEventListener("click", close);
    lb.querySelector("[data-rlb-next]")?.addEventListener("click", next);
    lb.querySelector("[data-rlb-prev]")?.addEventListener("click", prev);
    lb.addEventListener("click", (e) => {
      if (e.target === lb || e.target.classList.contains("rlb__stage")) close();
    });
    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") next(); // RTL: left = forward
      else if (e.key === "ArrowRight") prev();
    });
    let tx = 0;
    lb.addEventListener("touchstart", (e) => (tx = e.touches[0].clientX), { passive: true });
    lb.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - tx;
      if (set.length > 1 && Math.abs(dx) > 45) (dx < 0 ? prev : next)();
    }, { passive: true });
  }
</script>
