---
import { getCollection } from "astro:content";
import campaigns from "@/data/landing.js";

// Every /lp/ page was orphaned: nothing on the site linked to any of them, so
// Google could only reach them through the sitemap. This section is the
// homepage's link hub - it gives each page an internal inbound link and tells
// crawlers how the site is organised.
//
// Labels live here rather than in landing.js so the campaign data stays purely
// about the ad pages. hrefs are derived from the campaign list, so a slug that
// is removed or renamed drops out instead of becoming a dead link.
const LABELS = {
  stills: "צילום סטילס",
  video: "וידאו וסרט חתונה",
  "video-stills": "סטילס + וידאו",
  "weddings-small": "חתונה קטנה ואינטימית",
  "weddings-big-center": "חתונה גדולה",
  "weddings-outdoor": "חתונת שטח וטבע",
  "weddings-concept": "חתונת קונספט",
  "business-events": "אירועים עסקיים",
  "wedding-photographer-israel": "צלם חתונות בכל הארץ",
  "weddings-ashdod": "צלם חתונות באשדוד",
};

const GROUPS = [
  { title: "שירותי צילום", slugs: ["stills", "video", "video-stills"] },
  {
    title: "סוגי אירועים",
    slugs: [
      "weddings-small",
      "weddings-big-center",
      "weddings-outdoor",
      "weddings-concept",
      "business-events",
    ],
  },
  {
    title: "אזורי שירות",
    slugs: ["wedding-photographer-israel", "weddings-ashdod"],
  },
];

// Guides link straight from the homepage hub so each one gets an internal
// inbound link the day it is published. Drafts are skipped, as on /blog.
const guides = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((post) => ({ href: `/blog/${post.slug}/`, label: post.data.title }));

const known = new Set(campaigns.map((c) => c.slug));
const groups = GROUPS.map((g) => ({
  title: g.title,
  links: g.slugs
    .filter((s) => known.has(s) && LABELS[s])
    .map((s) => ({ href: `/lp/${s}/`, label: LABELS[s] })),
})).filter((g) => g.links.length > 0);
---

<section class="svclinks section section--edge" id="services" aria-labelledby="svclinks-title">
  <div class="container">
    <header class="svclinks__head">
      <p class="eyebrow" data-reveal>SERVICES</p>
      <h2 class="svclinks__title" id="svclinks-title" data-reveal>
        מה אנחנו מצלמים
      </h2>
      <p class="svclinks__lead" data-reveal>
        לכל סוג אירוע יש אופי משלו, ותיעוד שמתאים לו. בחרו את מה שרלוונטי לכם
        וקראו בהרחבה.
      </p>
    </header>

    {/* Folded on phones (script below): crawlers and desktop still get every
        link, a couple on a phone gets one line instead of a screen of lists. */}
    <button class="svclinks__toggle" type="button" data-svc-toggle hidden aria-expanded="false">
      עוד שירותים ומדריכים
    </button>
    <div class="svclinks__grid">
      {groups.map((g) => (
        <nav class="svclinks__col" data-reveal aria-label={g.title}>
          <h3 class="svclinks__coltitle">{g.title}</h3>
          <ul class="svclinks__list">
            {g.links.map((l) => (
              <li>
                <a class="svclinks__link" href={l.href}>
                  <span>{l.label}</span>
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 6l-6 6 6 6" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <nav class="svclinks__col" data-reveal aria-label="מהבלוג">
        <h3 class="svclinks__coltitle">מדריכים</h3>
        <ul class="svclinks__list">
          {guides.map((g) => (
            <li>
              <a class="svclinks__link" href={g.href}>
                <span>{g.label}</span>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6" />
                </svg>
              </a>
            </li>
          ))}
          <li>
            <a class="svclinks__link" href="/blog/">
              <span>הבלוג שלנו</span>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 6l-6 6 6 6" />
              </svg>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</section>

<script>
  const svc = document.querySelector(".svclinks");
  const svcToggle = svc?.querySelector("[data-svc-toggle]");
  if (svc && svcToggle) {
    svc.classList.add("is-folded");
    svcToggle.hidden = false;
    svcToggle.addEventListener("click", () => {
      const open = svc.classList.toggle("is-folded") === false;
      svcToggle.setAttribute("aria-expanded", String(open));
    });
  }
</script>

<style>
  .svclinks__toggle { display: none; }
  .svclinks__toggle[hidden] { display: none !important; }
  @media (max-width: 760px) {
    .svclinks.is-folded .svclinks__grid,
    .svclinks.is-folded .svclinks__lead { display: none; }
    .svclinks__toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 48px;
      border: 1px solid var(--line);
      border-radius: 12px;
      font-weight: 600;
      color: var(--chestnut);
      margin-block-end: 1rem;
    }
  }
  .svclinks { background: var(--paper); }
  .svclinks__head {
    max-width: 640px;
    text-align: center;
    margin-inline: auto;
    margin-block-end: clamp(2rem, 1.4rem + 2.2vw, 3.2rem);
  }
  .svclinks__head .eyebrow { margin-block-end: 0.8rem; }
  .svclinks__title { font-size: var(--fs-h2); margin-block-end: 0.9rem; }
  .svclinks__lead {
    color: var(--ink-60);
    font-weight: 300;
    line-height: 1.7;
  }

  .svclinks__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: clamp(1.6rem, 1rem + 2vw, 2.8rem);
  }

  .svclinks__coltitle {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chestnut);
    padding-block-end: 0.7rem;
    margin-block-end: 0.4rem;
    border-block-end: 1px solid var(--line);
  }

  .svclinks__list { display: flex; flex-direction: column; }
  .svclinks__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding-block: 0.62rem;
    color: var(--ink);
    font-weight: 300;
    line-height: 1.4;
    border-block-end: 1px solid var(--line-soft);
    transition: color 0.25s var(--ease), padding-inline-start 0.25s var(--ease);
  }
  .svclinks__link svg {
    flex: none;
    color: var(--ink-45);
    transition: transform 0.25s var(--ease), color 0.25s var(--ease);
  }
  .svclinks__link:hover { color: var(--chestnut); }
  .svclinks__link:hover svg {
    color: var(--chestnut);
    transform: translateX(-3px);
  }
</style>
