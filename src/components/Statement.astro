---
import site from "@/data/site.js";
const s = site.statement;
---

<section class="statement section" id="statement">
  <div class="container statement__inner">
    <p class="eyebrow" data-reveal>{s.eyebrow}</p>
    <p class="statement__text" data-reveal>{s.text}</p>
    <p class="statement__sign" data-reveal>{s.signature}</p>
  </div>
</section>

<style>
  .statement {
    background: var(--cream);
    text-align: center;
  }
  .statement__inner {
    max-width: 820px;
  }
  .statement .eyebrow {
    margin-block-end: 1.6rem;
  }
  .statement__text {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: clamp(1.35rem, 1rem + 1.8vw, 2.15rem);
    line-height: 1.55;
    color: var(--espresso);
    letter-spacing: -0.005em;
  }
  .statement__sign {
    margin-block-start: 2rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--chestnut);
    direction: rtl;
  }
</style>
