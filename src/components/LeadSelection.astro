---
// Package summary shown at the top of a lead form, plus the hidden fields that
// carry the finder's selection into the Netlify submission. Filled client-side
// by src/scripts/leadForm.js from sessionStorage / the "brothers:selection"
// event that PackageFinder dispatches. Must be rendered INSIDE the <form> so
// Netlify registers the hidden fields at build time.
import site from "@/data/site.js";

// finderAnchor: "#finder" when the page has a package finder, null otherwise
// (the card then stays hidden entirely).
const { finderAnchor = "#finder" } = Astro.props;
const t = site.contactSection.selection;
---

<input type="hidden" name="package" data-sel-field="pkgName" value="" />
<input type="hidden" name="coverage" data-sel-field="coverage" value="" />
<input type="hidden" name="extras" data-sel-field="extras" value="" />
<input type="hidden" name="price_from" data-sel-field="priceText" value="" />

{
  finderAnchor && (
    <div class="leadsel" data-lead-selection>
      <div class="leadsel__filled" data-sel-filled hidden>
        <div class="leadsel__head">
          <span class="leadsel__title">{t.title}</span>
          <a class="leadsel__change" href={finderAnchor}>{t.change}</a>
        </div>
        <p class="leadsel__summary">
          <strong data-sel-name></strong>
          <span data-sel-details></span>
        </p>
        <p class="leadsel__price" data-sel-price></p>
      </div>
      <p class="leadsel__empty" data-sel-empty>
        {t.empty} <a href={finderAnchor}>{t.emptyLink} ←</a>
      </p>
    </div>
  )
}

<style>
  .leadsel {
    margin-block-end: 1.2rem;
  }
  .leadsel__filled {
    background: var(--paper);
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--chestnut);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
  }
  .leadsel__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-block-end: 0.35rem;
  }
  .leadsel__title {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mocha);
  }
  .leadsel__change {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--chestnut);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .leadsel__summary {
    color: var(--espresso);
    line-height: 1.5;
  }
  .leadsel__summary strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    margin-inline-end: 0.4rem;
  }
  .leadsel__price {
    margin-block-start: 0.2rem;
    font-weight: 600;
    color: var(--chestnut);
  }
  .leadsel__empty {
    font-size: 0.95rem;
    color: var(--ink-60);
  }
  .leadsel__empty a {
    font-weight: 600;
    color: var(--chestnut);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
