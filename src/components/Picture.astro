---
// Responsive <picture> with WebP + JPEG, blur-up LQIP, and no-CLS sizing.
import { srcset, fallbackSrc, aspect } from "@/lib/images.js";

const {
  item,
  alt = "",
  sizes = "100vw",
  loading = "lazy",
  fetchpriority,
  decoding = "async",
  class: className = "",
} = Astro.props;

const ratio = aspect(item);
---

<picture class={`pic ${className}`} style={`--ratio:${ratio}`}>
  <source type="image/webp" srcset={srcset(item, "webp")} sizes={sizes} />
  <source type="image/jpeg" srcset={srcset(item, "jpg")} sizes={sizes} />
  <img
    src={fallbackSrc(item, "jpg")}
    alt={alt}
    width={item.width}
    height={item.height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={decoding}
    style={`background-image:url('${item.lqip}')`}
    onload="this.classList.add('is-loaded')"
  />
</picture>

<style>
  .pic {
    display: block;
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--cream-2);
  }
  .pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.7s var(--ease);
  }
  .pic img.is-loaded {
    opacity: 1;
  }
  /* If JS/onload never fires (e.g. cached), ensure visibility */
  .no-js .pic img,
  .pic img[data-forced] {
    opacity: 1;
  }
</style>
