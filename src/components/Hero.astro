---
import site from "@/data/site.js";
---

<section class="hero" id="hero">
  <!-- The hero is a logo image by design, which left the homepage with no H1
       at all. This carries the primary keyword for crawlers without touching
       the visual treatment. -->
  <h1 class="sr-only">
    צילום חתונות בכל הארץ - {site.brand} צילום ווידאו לחתונות ואירועים מאת {site.photographer}
  </h1>

  <div class="se-track" data-se-track>
    <div class="se-stage" data-se-stage>
      <!-- Brand mark that grows from small to full-screen as you scroll -->
      <div class="se-logo" data-se-logo>
        <img
          class="se-logo__img"
          data-se-logo-img
          src="/logo/brothers-plate.png"
          alt={`${site.brand} - ${site.photographer}`}
          width="1800"
          height="527"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <!-- Scroll cue on the resting field -->
      <div class="se-hint" data-se-hint aria-hidden="true">
        <span class="se-hint__text">{site.hero.scrollHint}</span>
        <span class="se-hint__line"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
  }

  .se-track {
    position: relative;
    width: 100%;
    /* Real height is set by the script; this keeps a sensible first paint. */
    min-height: 100svh;
  }

  .se-stage {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Clean cream field matching the logo plate's ground. */
    background: #e7d7c2;
  }

  .se-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 6%;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .se-logo__img {
    /* Size at full expansion (scale 1); the script scales it down at rest. */
    width: min(90vw, 900px);
    height: auto;
    transform: scale(0.34);
    transform-origin: center;
    will-change: transform;
    user-select: none;
    -webkit-user-drag: none;
  }

  .se-hint {
    position: absolute;
    inset-block-end: 1.6rem;
    inset-inline-start: 50%;
    transform: translateX(50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    pointer-events: none;
    will-change: opacity, transform;
  }
  .se-hint__text {
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-60);
  }
  .se-hint__line {
    width: 1px;
    height: 46px;
    background: linear-gradient(rgba(69, 50, 38, 0.55), rgba(69, 50, 38, 0));
    position: relative;
    overflow: hidden;
  }
  .se-hint__line::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: -50%;
    height: 50%;
    background: var(--espresso);
    animation: seScrollDot 2.2s var(--ease) infinite;
  }
  @keyframes seScrollDot {
    0% { transform: translateY(0); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translateY(300%); opacity: 0; }
  }

  @media (max-height: 700px) {
    .se-hint {
      display: none;
    }
  }
</style>

<script>
  const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
  const smoothstep = (e0: number, e1: number, x: number) => {
    const t = clamp((x - e0) / (e1 - e0 || 1e-6), 0, 1);
    return t * t * (3 - 2 * t);
  };

  // Tunable parameters for the logo expansion.
  const START_SCALE = 0.34; // logo size at rest (fraction of its full width)
  const END_SCALE = 1; // logo fills the stage
  const GROW_DISTANCE = 1.0; // logo growth length, in stage heights
  const REVEAL_DISTANCE = 1.0; // About slides up over the logo (keep at 1 for an exact cover)
  const REVEAL_PARALLAX = 0.28; // how far the logo drifts up during the reveal, in stage heights
  const SMOOTHING = 0.1; // follow time, seconds (0 = locked to scrollbar)

  const init = () => {
    const stage = document.querySelector<HTMLElement>("[data-se-stage]");
    const track = document.querySelector<HTMLElement>("[data-se-track]");
    const logo = document.querySelector<HTMLElement>("[data-se-logo]");
    const logoImg = document.querySelector<HTMLElement>("[data-se-logo-img]");
    const hint = document.querySelector<HTMLElement>("[data-se-hint]");
    // The next section (About) slides up over the pinned logo to cover it —
    // no gap, no fade over content. It needs to paint above the sticky stage.
    const next = document.querySelector<HTMLElement>("#hero + *");
    if (next) {
      next.style.position = "relative";
      next.style.zIndex = "2";
    }
    if (!stage || !track || !logoImg) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const TOTAL = GROW_DISTANCE + REVEAL_DISTANCE;

    let raf = 0;
    let current = 0;
    let target = 0;
    let stageH = 0;
    let running = false;

    const applyProgress = (q: number) => {
      const scrolled = q * TOTAL; // in stage heights

      // Grow phase: the logo scales up to fill the stage.
      const p = clamp(scrolled / GROW_DISTANCE, 0, 1);
      const e = smoothstep(0, 1, p);
      logoImg.style.transform = `scale(${START_SCALE + (END_SCALE - START_SCALE) * e})`;

      // Reveal phase: the logo drifts up and fades as About rises to cover it,
      // so it moves with the reveal instead of sitting frozen.
      const r = clamp((scrolled - GROW_DISTANCE) / REVEAL_DISTANCE, 0, 1);
      if (logo) {
        logo.style.transform = `translate3d(0, ${-REVEAL_PARALLAX * stageH * smoothstep(0, 1, r)}px, 0)`;
        logo.style.opacity = `${1 - smoothstep(0.1, 0.85, r)}`;
      }

      if (hint) {
        const gone = smoothstep(0, 0.12, p);
        hint.style.opacity = `${1 - gone}`;
        hint.style.transform = `translateX(50%) translate3d(0, ${8 * gone}px, 0)`;
      }
    };

    const measure = () => {
      stageH = window.innerHeight;
      if (stageH <= 0) return;
      stage.style.height = `${stageH}px`;
      track.style.height = `${stageH * (1 + TOTAL)}px`;
      // Pull About up so it rises over the pinned logo during the reveal phase.
      if (next) next.style.marginTop = `-${stageH * REVEAL_DISTANCE}px`;
    };

    const readProgress = () => {
      const span = stageH * Math.max(0.01, TOTAL);
      const top = track.getBoundingClientRect().top;
      return clamp(-top / span, 0, 1);
    };

    const tick = () => {
      const k = SMOOTHING <= 0 ? 1 : 1 - Math.exp(-1 / (60 * SMOOTHING));
      current += (target - current) * k;
      if (Math.abs(target - current) < 0.0004) {
        current = target;
        running = false;
      }
      applyProgress(current);
      raf = running ? requestAnimationFrame(tick) : 0;
    };

    const kick = () => {
      if (running) return;
      running = true;
      if (!raf) raf = requestAnimationFrame(tick);
    };

    const onScroll = () => {
      target = readProgress();
      if (SMOOTHING <= 0 || reduceMotion) {
        current = target;
        applyProgress(current);
        return;
      }
      kick();
    };

    const onResize = () => {
      measure();
      target = readProgress();
      current = target;
      applyProgress(current);
    };

    measure();
    target = readProgress();
    current = target;
    applyProgress(current);

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);
    const ro = new ResizeObserver(onResize);
    ro.observe(stage);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
