---
import site from "@/data/site.js";
import manifest from "@/data/gallery.generated.json";
import { srcset, fallbackSrc, resolveItem } from "@/lib/images.js";
import reviews from "@/data/reviews.json";

// One screen: a strong photo, one line, and a way to reach Yariv. The previous
// scroll-driven logo reveal took ~3 screen heights before any content, which
// lost visitors arriving from Instagram on a phone.
const h = site.hero;
const bg = resolveItem(manifest, h.imageId);
const wa = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(site.contact.whatsappText)}`;
---

<section class="hero" id="hero">
  <div class="hero__media">
    <picture>
      <source type="image/webp" srcset={srcset(bg, "webp")} sizes="100vw" />
      <source type="image/jpeg" srcset={srcset(bg, "jpg")} sizes="100vw" />
      <img
        src={fallbackSrc(bg, "jpg")}
        alt={`זוג מתנשק בשדה פתוח בשעת שקיעה - ${site.brand} צילום חתונות`}
        width={bg.width}
        height={bg.height}
        fetchpriority="high"
        decoding="async"
        style={`background-image:url('${bg.lqip}')`}
      />
    </picture>
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__inner container">
    {/* No text headline over the photo (Yariv's call, 05/10), just the logo.
        It is the page's h1, and its alt carries the words search engines
        read there: "Brothers. צילום חתונות בכל הארץ". */}
    <div class="hero__stack">
    <h1 class="hero__brand">
      <img
        class="hero__logo"
        src="/logo/logo-white.png"
        alt={`${site.brand} צילום חתונות בכל הארץ`}
        width="700"
        height="205"
      />
    </h1>
    <p class="hero__subtitle">{h.subtitle}</p>
    <div class="hero__actions">
      <a
        class="btn btn--light"
        href={h.ctaPrimary.href}
        data-track="cta"
        data-track-loc="hero"
        data-track-label="availability"
      >{h.ctaPrimary.label}</a>
      <a
        class="btn btn--outline-light"
        href={h.ctaSecondary.href}
        data-track="cta"
        data-track-loc="hero"
        data-track-label="packages"
      >{h.ctaSecondary.label}</a>
    </div>
    <p class="hero__micro">{h.ctaMicro}</p>
    {/* Phones only: the rating otherwise first shows on screen two. */}
    <p class="hero__trust">
      <span class="hero__stars" aria-hidden="true">★★★★★</span>
      {`${reviews.score}/${reviews.scoreMax} לפי ${reviews.count} זוגות`}
    </p>
    {/* Desktop only. On a phone every path runs through the finder, so the
        couple reaches Yariv with their details rather than a blank chat. */}
    <a
      class="hero__wa"
      href={wa}
      target="_blank"
      rel="noopener"
      data-track="contact"
      data-track-method="whatsapp"
      data-track-loc="hero"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.5 9.5 0 01-4.84-1.33l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 01-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.43 9.43 0 012.78 6.72c0 5.24-4.26 9.5-9.5 9.5zm5.53-15.01A11.42 11.42 0 0012.03.5C5.74.5.62 5.62.62 11.9c0 2.09.55 4.13 1.6 5.92L.5 23.5l5.82-1.53a11.36 11.36 0 005.71 1.46h.01c6.28 0 11.4-5.12 11.4-11.4 0-3.05-1.19-5.91-3.35-8.06z"></path>
      </svg>
      <span>{h.ctaWhatsapp}</span>
    </a>
    </div>
    {/* In flow, not absolutely positioned: .hero is align-items:flex-end and
        at <=560px the two CTAs stack full-width, so a bottom-pinned cue would
        land on top of them on a short phone. */}
    <a class="hero__scroll" href="#trust" aria-label={h.scrollHint}>
      <span class="hero__scroll-text">{h.scrollHint}</span>
      <svg
        class="hero__scroll-chev"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 9l6 6 6-6" />
      </svg>
    </a>
  </div>
</section>

<style>
  .hero__scroll {
    /* Block-level, not inline-flex: .hero__wa is inline-flex too, so an inline
       cue shares its line and pushes the WhatsApp label off the edge. */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-block-start: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    min-height: 44px;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-shadow: 0 1px 14px rgba(30, 20, 14, 0.55);
    transition: opacity 0.45s var(--ease), color 0.3s var(--ease);
  }
  .hero__scroll:hover { color: #fff; }
  .hero__scroll-chev { animation: heroBob 2.1s var(--ease) infinite; }
  @keyframes heroBob {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(6px); opacity: 1; }
  }
  /* Fades out once the visitor starts moving. Reuses the class
     FloatingWhatsApp already puts on <html>; both are homepage-only, so they
     are always present or absent together. */
  :global(html.fabs-revealed) .hero__scroll {
    opacity: 0;
    pointer-events: none;
  }
  /* The global reduced-motion rule crushes animation-duration, which would
     freeze the chevron mid-keyframe at opacity 0.6. */
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-chev { animation: none; opacity: 0.85; }
  }

  .hero__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 1.3rem;
    color: rgba(255, 255, 255, 0.92);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(255, 255, 255, 0.45);
    transition: text-decoration-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .hero__wa:hover {
    color: #fff;
    text-decoration-color: #fff;
  }
  .hero__wa svg { flex: none; }

  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 7rem clamp(2.6rem, 1.8rem + 5vw, 6rem);
    color: #fff;
    overflow: hidden;
    background: var(--espresso);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media picture,
  .hero__media img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__media img {
    object-fit: cover;
    /* Keeps the couple in frame on portrait phones. */
    object-position: 44% 45%;
    background-size: cover;
    background-position: center;
    animation: heroZoom 14s var(--ease) forwards;
  }
  @keyframes heroZoom {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(40, 28, 20, 0.82) 0%,
      rgba(40, 28, 20, 0.35) 42%,
      rgba(40, 28, 20, 0.1) 68%,
      rgba(40, 28, 20, 0.45) 100%
    );
  }

  /* One centred column: logo, line, CTA, reassurance - a single composed
     block rather than copy hugging one edge. On a phone it sits mid-screen;
     on wider screens it moves to the right third, because the couple stands
     in the middle of the photo and a centred block would cover them. */
  .hero__inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 30rem;
    text-align: center;
  }
  @media (min-width: 761px) {
    .hero__stack { align-self: flex-start; } /* RTL: the right side */
  }
  .hero__brand {
    opacity: 0;
    transform: translateY(20px);
    animation: heroLine 0.9s var(--ease) 0.1s forwards;
  }
  .hero__logo {
    display: block;
    margin-inline: auto;
    width: clamp(190px, 140px + 11vw, 300px);
    height: auto;
    margin-block-end: 0.4rem;
    filter: drop-shadow(0 2px 14px rgba(30, 20, 14, 0.4));
  }
  @keyframes heroLine {
    to { opacity: 1; transform: none; }
  }
  .hero__subtitle {
    margin-block-start: 1.1rem;
    max-width: 40ch;
    text-wrap: balance;
    font-size: var(--fs-lead);
    font-weight: 300;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero__actions {
    margin-block-start: 1.8rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }

  @media (max-width: 560px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }
  .hero__micro,
  .hero__trust { display: none; }
  /* One decision on a phone: the finder. Packages lives inside it anyway. */
  @media (max-width: 760px) {
    .hero__actions .btn--outline-light,
    .hero__wa { display: none; }
    /* Tighter rhythm on a phone, so the block stays below the couple's
       faces and shoulders rather than across them. */
    .hero { padding-block-end: 1.4rem; }
    .hero__logo { width: 172px; margin-block-end: 0.2rem; }
    .hero__subtitle { margin-block-start: 0.7rem; font-size: 1.02rem; line-height: 1.5; }
    .hero__scroll { display: none; }
    .hero__actions { width: 100%; max-width: 340px; margin-block-start: 1.3rem; }
    .hero__actions .btn--light { min-height: 56px; font-size: 0.88rem; }
    .hero__micro {
      display: block;
      margin-block-start: 0.8rem;
      text-align: center;
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.85);
    }
    .hero__trust {
      display: block;
      margin-block-start: 0.35rem;
      text-align: center;
      font-size: 0.88rem;
      font-weight: 600;
      color: #fff;
    }
    .hero__stars { color: #e3b878; letter-spacing: 0.08em; margin-inline-end: 0.3rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media img { animation: none; }
    .hero__brand { animation: none; opacity: 1; transform: none; }
  }
</style>
