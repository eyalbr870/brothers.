---
import site from "@/data/site.js";
import manifest from "@/data/gallery.generated.json";
import { srcset, fallbackSrc, resolveItem } from "@/lib/images.js";

// One screen: a strong photo, one line, and a way to reach Yariv. The previous
// scroll-driven logo reveal took ~3 screen heights before any content, which
// lost visitors arriving from Instagram on a phone.
const h = site.hero;
const bg = resolveItem(manifest, h.imageId);
const titleLines = h.title.split("\n");
const wa = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(site.contact.whatsappText)}`;
---

<section class="hero" id="hero">
  <div class="hero__media">
    <picture>
      <source type="image/webp" srcset={srcset(bg, "webp")} sizes="100vw" />
      <source type="image/jpeg" srcset={srcset(bg, "jpg")} sizes="100vw" />
      <img
        src={fallbackSrc(bg, "jpg")}
        alt={`זוג מתנשק בשקיעה על חוף הים - ${site.brand} צילום חתונות`}
        width={bg.width}
        height={bg.height}
        fetchpriority="high"
        decoding="async"
        style={`background-image:url('${bg.lqip}')`}
      />
    </picture>
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__inner container">
    <h1 class="hero__title">
      <span class="eyebrow hero__eyebrow">צילום חתונות בכל הארץ · {site.photographer}</span>
      {titleLines.map((line, i) => (
        <span class="hero__line" style={`--i:${i}`}>{line}</span>
      ))}
    </h1>
    <p class="hero__subtitle">{h.subtitle}</p>
    <div class="hero__actions">
      <a class="btn btn--light" href={wa} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.5 9.5 0 01-4.84-1.33l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 01-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.43 9.43 0 012.78 6.72c0 5.24-4.26 9.5-9.5 9.5zm5.53-15.01A11.42 11.42 0 0012.03.5C5.74.5.62 5.62.62 11.9c0 2.09.55 4.13 1.6 5.92L.5 23.5l5.82-1.53a11.36 11.36 0 005.71 1.46h.01c6.28 0 11.4-5.12 11.4-11.4 0-3.05-1.19-5.91-3.35-8.06z"></path>
        </svg>
        <span>{h.ctaWhatsapp}</span>
      </a>
      <a class="btn btn--outline-light" href={h.ctaPrimary.href}>{h.ctaPrimary.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 7rem clamp(2.6rem, 1.8rem + 5vw, 6rem);
    color: #fff;
    overflow: hidden;
    background: var(--espresso);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media picture,
  .hero__media img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__media img {
    object-fit: cover;
    /* Keeps the couple in frame on portrait phones. */
    object-position: 44% 45%;
    background-size: cover;
    background-position: center;
    animation: heroZoom 14s var(--ease) forwards;
  }
  @keyframes heroZoom {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(40, 28, 20, 0.82) 0%,
      rgba(40, 28, 20, 0.35) 42%,
      rgba(40, 28, 20, 0.1) 68%,
      rgba(40, 28, 20, 0.45) 100%
    );
  }

  .hero__inner {
    width: 100%;
  }
  .hero__eyebrow {
    display: block;
    color: rgba(255, 255, 255, 0.88);
    margin-block-end: 1.1rem;
    line-height: 1.5;
    /* Hebrew label: undo the Latin-only LTR + wide tracking from .eyebrow. */
    direction: rtl;
    letter-spacing: 0.12em;
    text-shadow: none;
  }
  .hero__title {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--fs-h1);
    line-height: 0.98;
    letter-spacing: -0.015em;
    color: #fff;
    text-shadow: 0 2px 30px rgba(30, 20, 14, 0.35);
  }
  .hero__line {
    display: block;
    opacity: 0;
    transform: translateY(32px);
    animation: heroLine 0.9s var(--ease) forwards;
    animation-delay: calc(0.1s + var(--i) * 0.1s);
  }
  @keyframes heroLine {
    to { opacity: 1; transform: none; }
  }
  .hero__subtitle {
    margin-block-start: 1.3rem;
    max-width: 44ch;
    font-size: var(--fs-lead);
    font-weight: 300;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero__actions {
    margin-block-start: 1.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  @media (max-width: 560px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media img { animation: none; }
    .hero__line { animation: none; opacity: 1; transform: none; }
  }
</style>
