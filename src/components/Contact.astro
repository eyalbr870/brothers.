---
import site from "@/data/site.js";
import manifest from "@/data/gallery.generated.json";
import Picture from "@/components/Picture.astro";

const c = site.contactSection;
const bg = manifest.backgrounds.contact;
const titleLines = c.title.split("\n");
const wa = `https://wa.me/${site.contact.whatsapp}`;
---

<section class="contact" id="contact">
  <div class="contact__media" data-reveal>
    <Picture
      item={bg}
      alt="זוג בשקיעה — Brothers. צילום חתונות"
      sizes="(max-width: 960px) 100vw, 42vw"
      class="contact__pic"
    />
    <div class="contact__media-scrim"></div>
    <blockquote class="contact__quote">
      <p>“הרגעים הכי יפים הם אלה שקורים מעצמם.”</p>
    </blockquote>
  </div>

  <div class="contact__panel">
    <div class="contact__panel-inner">
      <p class="eyebrow" data-reveal>{c.eyebrow}</p>
      <h2 class="contact__title" data-reveal>
        {titleLines.map((l) => <span>{l}</span>)}
      </h2>
      <p class="contact__subtitle" data-reveal>{c.subtitle}</p>

      <form
        class="form"
        data-form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-reveal
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden-field" hidden>
          <label>אל תמלאו שדה זה: <input name="bot-field" /></label>
        </p>
        <div class="form__row">
          <div class="field">
            <input id="f-name" name="name" type="text" required autocomplete="name" placeholder=" " />
            <label for="f-name">{c.form.name}</label>
          </div>
          <div class="field">
            <input id="f-phone" name="phone" type="tel" required autocomplete="tel" placeholder=" " />
            <label for="f-phone">{c.form.phone}</label>
          </div>
        </div>
        <div class="form__row">
          <div class="field">
            <input id="f-email" name="email" type="email" autocomplete="email" placeholder=" " />
            <label for="f-email">{c.form.email}</label>
          </div>
          <div class="field">
            <input id="f-date" name="event_date" type="text" placeholder=" " onfocus="this.type='date'" onblur="if(!this.value)this.type='text'" />
            <label for="f-date">{c.form.date}</label>
          </div>
        </div>
        <div class="field">
          <textarea id="f-msg" name="message" rows="4" placeholder=" "></textarea>
          <label for="f-msg">{c.form.message}</label>
        </div>
        <button class="btn form__submit" type="submit" data-submit>
          <span data-submit-label>{c.form.submit}</span>
        </button>
        <p class="form__status" data-status role="status" aria-live="polite"></p>
      </form>

      <div class="contact__direct" data-reveal>
        <span class="contact__direct-label">{c.directLabel}</span>
        <div class="contact__links">
          <a class="clink" href={wa} target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.5 9.5 0 01-4.84-1.33l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 01-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.43 9.43 0 012.78 6.72c0 5.24-4.26 9.5-9.5 9.5zm5.53-15.01A11.42 11.42 0 0012.03.5C5.74.5.62 5.62.62 11.9c0 2.09.55 4.13 1.6 5.92L.5 23.5l5.82-1.53a11.36 11.36 0 005.71 1.46h.01c6.28 0 11.4-5.12 11.4-11.4 0-3.05-1.19-5.91-3.35-8.06z"/></svg>
            <span>WhatsApp</span>
          </a>
          <a class="clink" href={`tel:${site.contact.phoneIntl}`} aria-label="טלפון">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 1.9.7 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.8.6 2.8.7a2 2 0 011.7 2z"/></svg>
            <span dir="ltr">{site.contact.phoneDisplay}</span>
          </a>
          <a class="clink" href={site.contact.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
            <span dir="ltr">@{site.contact.instagram}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    background: var(--cream);
    min-height: 80vh;
  }
  @media (max-width: 960px) {
    .contact { grid-template-columns: 1fr; }
  }

  .contact__media {
    position: relative;
    overflow: hidden;
    min-height: 340px;
  }
  .contact__media :global(.contact__pic),
  .contact__media :global(.contact__pic img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .contact__media-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(40, 28, 20, 0.55), rgba(40, 28, 20, 0.12));
  }
  .contact__quote {
    position: absolute;
    inset-block-end: clamp(1.5rem, 3vw, 3rem);
    inset-inline: clamp(1.5rem, 3vw, 3rem);
    color: #fff;
  }
  .contact__quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 1rem + 1vw, 1.7rem);
    line-height: 1.5;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }

  .contact__panel {
    display: flex;
    align-items: center;
    padding: clamp(2.5rem, 1.5rem + 5vw, 6rem) var(--gutter);
  }
  .contact__panel-inner {
    width: 100%;
    max-width: 620px;
    margin-inline: auto;
  }
  .contact__panel .eyebrow { margin-block-end: 1.1rem; }
  .contact__title {
    font-size: var(--fs-h2);
    line-height: 1.05;
    margin-block-end: 1.1rem;
  }
  .contact__title span { display: block; }
  .contact__subtitle {
    color: var(--ink-60);
    font-weight: 300;
    font-size: var(--fs-lead);
    margin-block-end: 2.4rem;
  }

  /* ---- Form ---- */
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 480px) {
    .form__row { grid-template-columns: 1fr; }
  }
  .field {
    position: relative;
    margin-block-end: 1rem;
  }
  .field input,
  .field textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--espresso);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.15rem 1rem 0.5rem;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .field textarea {
    padding-top: 1.4rem;
    resize: vertical;
    min-height: 116px;
  }
  .field label {
    position: absolute;
    inset-inline-start: 1rem;
    top: 0.95rem;
    font-size: 1rem;
    color: var(--ink-45);
    pointer-events: none;
    transition: transform 0.22s var(--ease), font-size 0.22s var(--ease), color 0.22s var(--ease);
    transform-origin: inline-start;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--chestnut);
    box-shadow: 0 0 0 3px rgba(125, 88, 68, 0.12);
  }
  .field input:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label,
  .field textarea:not(:placeholder-shown) + label {
    transform: translateY(-0.7rem) scale(0.8);
    color: var(--chestnut);
  }

  .form__submit {
    width: 100%;
    margin-block-start: 0.4rem;
  }
  .form__status {
    margin-block-start: 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    min-height: 1.4em;
  }
  .form__status.is-ok { color: #4b7d4b; }
  .form__status.is-err { color: #b0483a; }

  /* ---- Direct links ---- */
  .contact__direct {
    margin-block-start: 2.6rem;
    padding-block-start: 1.8rem;
    border-block-start: 1px solid var(--line);
  }
  .contact__direct-label {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--mocha);
    display: block;
    margin-block-end: 1rem;
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .clink {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 100px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--espresso);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease), color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .clink:hover {
    transform: translateY(-2px);
    border-color: var(--chestnut);
    color: var(--chestnut);
    background: #fff;
  }
  .clink svg { flex: none; }
</style>

<script is:inline define:vars={{ formCfg: site.contactSection.form }}>
  const form = document.querySelector("[data-form]");
  const status = form?.querySelector("[data-status]");
  const submit = form?.querySelector("[data-submit]");
  const label = form?.querySelector("[data-submit-label]");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    status.className = "form__status";
    status.textContent = "";

    // Local dev has no Netlify backend — the POST to "/" won't record a
    // submission. Show a clear notice instead of a false success.
    if (location.hostname === "localhost" || location.hostname === "127.0.0.1") {
      status.classList.add("is-err");
      status.textContent = "בסביבת פיתוח הטופס אינו נשלח — יעבוד לאחר פריסה ל‑Netlify.";
      return;
    }

    submit.disabled = true;
    const original = label.textContent;
    label.textContent = formCfg.sending;
    try {
      // Netlify Forms AJAX submission
      const res = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(new FormData(form)).toString(),
      });
      if (res.ok) {
        form.reset();
        status.classList.add("is-ok");
        status.textContent = formCfg.success;
      } else {
        throw new Error("bad response");
      }
    } catch {
      status.classList.add("is-err");
      status.textContent = formCfg.error;
    } finally {
      submit.disabled = false;
      label.textContent = original;
    }
  });
</script>
