---
import site from "@/data/site.js";
const wa = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(site.contact.whatsappText)}`;
---

<a
  class="fab"
  href={wa}
  target="_blank"
  rel="noopener"
  aria-label="שליחת הודעה בוואטסאפ"
>
  <span class="fab__label">דברו איתי</span>
  <span class="fab__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
      <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.5 9.5 0 01-4.84-1.33l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 01-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.43 9.43 0 012.78 6.72c0 5.24-4.26 9.5-9.5 9.5zm5.53-15.01A11.42 11.42 0 0012.03.5C5.74.5.62 5.62.62 11.9c0 2.09.55 4.13 1.6 5.92L.5 23.5l5.82-1.53a11.36 11.36 0 005.71 1.46h.01c6.28 0 11.4-5.12 11.4-11.4 0-3.05-1.19-5.91-3.35-8.06z"></path>
    </svg>
  </span>
</a>

<style>
  .fab {
    position: fixed;
    inset-block-end: clamp(1.1rem, 0.6rem + 1.5vw, 1.9rem);
    inset-inline-start: clamp(1.1rem, 0.6rem + 1.5vw, 1.9rem);
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0;
    height: 60px;
    padding: 0;
    border-radius: 100px;
    background: var(--chestnut);
    color: var(--paper);
    box-shadow: 0 12px 30px -8px rgba(69, 50, 38, 0.55), 0 4px 10px -4px rgba(0, 0, 0, 0.25);
    transition: background 0.35s var(--ease), transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
    /* entrance */
    opacity: 0;
    transform: translateY(14px) scale(0.9);
    animation: fabIn 0.6s var(--ease) 0.7s forwards;
    overflow: hidden;
  }
  @keyframes fabIn {
    to { opacity: 1; transform: none; }
  }

  .fab:hover {
    background: var(--espresso);
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -10px rgba(69, 50, 38, 0.6);
  }

  .fab__icon {
    flex: none;
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    position: relative;
  }
  /* pulse ring */
  .fab__icon::before {
    content: "";
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    border: 2px solid var(--sand);
    opacity: 0;
    animation: fabPulse 2.6s var(--ease) infinite;
  }
  @keyframes fabPulse {
    0% { transform: scale(0.85); opacity: 0.5; }
    70% { transform: scale(1.5); opacity: 0; }
    100% { opacity: 0; }
  }

  /* label expands on hover (desktop pointers only) */
  .fab__label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    white-space: nowrap;
    max-width: 0;
    opacity: 0;
    padding-inline-start: 0;
    transition: max-width 0.4s var(--ease), opacity 0.35s var(--ease), padding 0.4s var(--ease);
  }
  @media (hover: hover) and (min-width: 700px) {
    .fab:hover .fab__label {
      max-width: 200px;
      opacity: 1;
      padding-inline-start: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab { animation: none; opacity: 1; transform: none; }
    .fab__icon::before { animation: none; }
  }
</style>
