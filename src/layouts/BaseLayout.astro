---
import "@/styles/global.css";
import site from "@/data/site.js";
import manifest from "@/data/gallery.generated.json";
import reviews from "@/data/reviews.json";
import { largestSrc } from "@/lib/images.js";
import Analytics from "@/components/Analytics.astro";

const { title = site.title, description = site.description } = Astro.props;
const heroPreload = `/${manifest.hero.dir}/${manifest.hero.id}-1920.jpg`;
// Canonical from the configured production domain (astro.config `site`).
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
const siteUrl = (Astro.site || new URL("https://brothers-photography.com")).href;
const ogImage = new URL("/og-image.jpg", Astro.site || "https://brothers-photography.com").href;

// ---- Ratings from the aggregated mit4mit data (src/data/reviews.json) ----
// score is out of 100; convert to a 5-star value for schema.org rich results.
const ratingValue = Math.round((reviews.score / reviews.scoreMax) * 5 * 10) / 10;
// A handful of full testimonials, surfaced as individual Review nodes so
// search + AI engines can quote them and show stars.
const featuredReviews = reviews.reviews.slice(0, 6);

// Rich LocalBusiness schema: identity + service area + rating + reviews.
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${siteUrl}#business`,
  name: `${site.brand} - ${site.photographer}`,
  image: ogImage,
  url: siteUrl,
  description,
  email: site.contact.email,
  telephone: site.contact.phoneIntl,
  priceRange: "$$",
  founder: { "@type": "Person", name: site.photographer },
  areaServed: { "@type": "Country", name: "ישראל" },
  sameAs: [site.contact.instagramUrl, reviews.source],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue,
    bestRating: 5,
    ratingCount: reviews.count,
  },
  review: featuredReviews.map((r) => ({
    "@type": "Review",
    author: { "@type": "Person", name: r.name },
    datePublished: r.date,
    reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: 5 },
    reviewBody: r.text,
  })),
};
---

<!doctype html>
<html lang={site.lang} dir={site.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#453226" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Social Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.brand} - ${site.photographer}`} />
    <meta property="og:locale" content="he_IL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preload critical assets -->
    <link rel="preload" as="image" href={heroPreload} fetchpriority="high" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/FrankRuhlLibre-SemiBold.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Assistant-Regular.woff2"
      crossorigin
    />

    <!-- Structured data: LocalBusiness + rating + reviews -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <!-- GA4 + Meta Pixel (each off until its real id is set in site.js) -->
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#gallery">דילוג לגלריה</a>
    <slot />

    <style>
      .skip-link {
        position: absolute;
        inset-inline-start: -9999px;
        top: 0;
        z-index: 999;
        background: var(--espresso);
        color: #fff;
        padding: 0.8rem 1.2rem;
        border-radius: 0 0 4px 0;
      }
      .skip-link:focus {
        inset-inline-start: 0;
      }
    </style>

    <script>
      // Global reveal-on-scroll for [data-reveal]
      const reveals = document.querySelectorAll("[data-reveal]");
      if (reveals.length) {
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        reveals.forEach((el) => obs.observe(el));
      }
    </script>
  </body>
</html>
