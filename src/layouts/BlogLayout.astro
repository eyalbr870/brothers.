---
import "@/styles/global.css";
import site from "@/data/site.js";
import manifest from "@/data/gallery.generated.json";
import { largestSrc, resolveItem } from "@/lib/images.js";
import { localBusinessSchema } from "@/lib/schema.js";
import Analytics from "@/components/Analytics.astro";

// Shared shell for /blog and /blog/<slug>. Mirrors LandingLayout's slim
// topbar (the home nav is anchor-based and would dead-scroll here), but adds
// article-oriented metadata and prose styling.
const {
  title = site.title,
  description = site.description,
  coverId,
  article, // { publishDate, updatedDate } - present on post pages only
} = Astro.props;

const coverItem = resolveItem(manifest, coverId);
const coverSrc = largestSrc(coverItem, "jpg");
const ogImage = new URL(coverSrc, Astro.site || "https://brothers-photography.com").href;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
const siteUrl = (Astro.site || new URL("https://brothers-photography.com")).href;

// BlogPosting schema - lets Google and AI engines attribute the article to the
// business and surface it for the question it answers.
const articleSchema = article && {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: ogImage,
  inLanguage: "he-IL",
  datePublished: article.publishDate.toISOString(),
  ...(article.updatedDate && { dateModified: article.updatedDate.toISOString() }),
  author: { "@type": "Person", name: site.photographer },
  publisher: {
    "@type": "Organization",
    name: `${site.brand} - ${site.photographer}`,
    logo: { "@type": "ImageObject", url: new URL("/logo/logo-color.png", siteUrl).href },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
};

// The same business entity the rest of the site declares, so a blog page
// resolves to one org rather than looking like an unattached article.
const businessSchema = localBusinessSchema({ siteUrl, description, image: ogImage });

// Breadcrumbs help Google render the /blog path under the result.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "בית", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "בלוג", item: new URL("/blog/", siteUrl).href },
    ...(article ? [{ "@type": "ListItem", position: 3, name: title, item: canonical }] : []),
  ],
};
---

<!doctype html>
<html lang={site.lang} dir={site.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#453226" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="he_IL" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href={coverSrc} fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/FrankRuhlLibre-SemiBold.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Assistant-Regular.woff2" crossorigin />

    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#article">דילוג לתוכן</a>

    <header class="blog-topbar">
      <a class="blog-topbar__brand" href="/" aria-label={site.brand}>
        <img src="/logo/logo-black.png" alt={site.brand} width="180" height="52" />
      </a>
      <nav class="blog-topbar__nav" aria-label="ניווט">
        <a href="/blog/">בלוג</a>
        <a href="/#gallery">גלריה</a>
        <a class="btn blog-topbar__cta" href="/#contact">תיאום פגישה</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <style>
      .skip-link {
        position: absolute;
        inset-inline-start: -9999px;
        top: 0;
        z-index: 999;
        background: var(--espresso);
        color: #fff;
        padding: 0.8rem 1.2rem;
        border-radius: 0 0 4px 0;
      }
      .skip-link:focus { inset-inline-start: 0; }

      .blog-topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem var(--gutter);
        background: var(--paper);
        border-block-end: 1px solid var(--line);
      }
      .blog-topbar__brand img { height: 40px; width: auto; display: block; }
      .blog-topbar__nav {
        display: flex;
        align-items: center;
        gap: clamp(0.8rem, 2vw, 1.6rem);
        font-family: var(--font-label);
        font-weight: 600;
        font-size: 0.88rem;
      }
      .blog-topbar__nav a { color: var(--espresso); }
      .blog-topbar__nav a:hover { color: var(--chestnut); }
      .blog-topbar__cta {
        padding: 0.55rem 1.1rem;
        font-size: 0.8rem;
      }
      .blog-topbar__cta:hover { color: #fff; }
      @media (max-width: 520px) {
        .blog-topbar__nav a:not(.btn) { display: none; }
      }
    </style>

    <script>
      const reveals = document.querySelectorAll("[data-reveal]");
      if (reveals.length) {
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        reveals.forEach((el) => obs.observe(el));
      }
    </script>
  </body>
</html>
