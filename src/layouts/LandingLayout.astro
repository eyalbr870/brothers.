---
import "@/styles/global.css";
import site from "@/data/site.js";
import manifest from "@/data/gallery.generated.json";
import { largestSrc, resolveItem, srcset, fallbackSrc } from "@/lib/images.js";
import { localBusinessSchema } from "@/lib/schema.js";
import LpStickyCTA from "@/components/lp/LpStickyCTA.astro";
import Analytics from "@/components/Analytics.astro";

const { campaign } = Astro.props;

const title = campaign.seo?.title ?? site.title;
const description = campaign.seo?.description ?? site.description;

// OG image + hero preload from the campaign's chosen photos.
const ogItem = resolveItem(manifest, campaign.seo?.ogImageId ?? campaign.hero?.bgId);
// Absolute: og:image and schema.org both discard relative paths.
const ogImage = new URL(
  largestSrc(ogItem, "jpg"),
  Astro.site || "https://brothers-photography.com"
).href;
const heroItem = resolveItem(manifest, campaign.hero?.bgId);
// LpHero renders a <picture> whose WebP source wins at 100vw. Preloading the
// largest JPEG instead pulled ~191 KB that the page never used, on top of the
// WebP it did. Mirror the real candidate set so the preload and the render
// resolve to the same file.
const heroSrcset = srcset(heroItem, "webp");
const heroPreload = fallbackSrc(heroItem, "webp");

// Self-referencing canonical (also fixes the site-wide empty canonical).
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// Rich LocalBusiness schema (identity + service area + hours + rating).
// Shared with the homepage via src/lib/schema.js - the two used to be
// separate copies, which is how this one ended up with a relative image URL.
const siteUrl = (Astro.site || new URL("https://brothers-photography.com")).href;
const businessSchema = localBusinessSchema({ siteUrl, description, image: ogImage });
---

<!doctype html>
<html lang={site.lang} dir={site.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#453226" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preload critical assets -->
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href={heroPreload}
      imagesrcset={heroSrcset}
      imagesizes="100vw"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/FrankRuhlLibre-SemiBold.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Assistant-Regular.woff2"
      crossorigin
    />

    <!-- Structured data: LocalBusiness + aggregated rating -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <!-- GA4 + Meta Pixel + lpTrack helpers (each off until its id is set) -->
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#lead">דילוג לטופס יצירת קשר</a>

    <header class="lp-topbar">
      <a class="lp-topbar__brand" href="#top" aria-label={site.brand}>
        <img src="/logo/logo-black.png" alt={site.brand} width="180" height="52" />
      </a>
      <a
        class="lp-topbar__phone"
        href={`tel:${site.contact.phoneIntl}`}
        dir="ltr"
        data-lp-call
        aria-label="חייגו אלינו"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 1.9.7 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.8.6 2.8.7a2 2 0 011.7 2z"/></svg>
        <span>{site.contact.phoneDisplay}</span>
      </a>
    </header>

    <span id="top"></span>
    <main>
      <slot />
    </main>

    <LpStickyCTA campaign={campaign} />

    <style>
      .skip-link {
        position: absolute;
        inset-inline-start: -9999px;
        top: 0;
        z-index: 999;
        background: var(--espresso);
        color: #fff;
        padding: 0.8rem 1.2rem;
        border-radius: 0 0 4px 0;
      }
      .skip-link:focus {
        inset-inline-start: 0;
      }

      .lp-topbar {
        position: relative;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem var(--gutter);
        background: var(--paper);
        border-block-end: 1px solid var(--line);
      }
      .lp-topbar__brand img {
        height: 40px;
        width: auto;
        display: block;
      }
      .lp-topbar__phone {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-label);
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--espresso);
        letter-spacing: 0.02em;
        white-space: nowrap;
      }
      .lp-topbar__phone svg { color: var(--chestnut); }
      .lp-topbar__phone:hover { color: var(--chestnut); }
      @media (max-width: 420px) {
        .lp-topbar__phone span { display: none; }
      }
    </style>

    <script>
      // Global reveal-on-scroll for [data-reveal] (same as BaseLayout).
      const reveals = document.querySelectorAll("[data-reveal]");
      if (reveals.length) {
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        reveals.forEach((el) => obs.observe(el));
      }
    </script>
  </body>
</html>
