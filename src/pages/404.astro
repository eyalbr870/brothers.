---
// ============================================================
// Custom 404 - "הרגע הזה לא נתפס".
//
// Deliberately NOT built on BaseLayout: that layout preloads the homepage
// hero, injects the full LocalBusiness + reviews schema and points its skip
// link at #gallery, none of which belongs on a dead-end page. The site header
// is skipped for the same reason - its nav is anchor-only (#about, #gallery…)
// and every link would dead-scroll here. The slim topbar below mirrors
// BlogLayout's, with absolute paths that work from any URL depth.
//
// Netlify serves dist/404.html automatically for unmatched paths on a static
// build, so no redirect rule is needed in netlify.toml.
// ============================================================
import "@/styles/global.css";
import site from "@/data/site.js";
import manifest from "@/data/gallery.generated.json";
import { srcset, fallbackSrc, resolveItem } from "@/lib/images.js";
import Analytics from "@/components/Analytics.astro";

const title = `הדף לא נמצא · ${site.brand}`;
const description =
  "הדף שחיפשתם לא קיים או שהכתובת השתנתה. אפשר לחזור לעמוד הבית, לעבור לגלריה או לבדוק זמינות לתאריך שלכם.";

// The contact background: a warm, wide frame that reads well behind text and
// is already generated in three widths (1200/1920/2560).
const bg = resolveItem(manifest, "contact");
const wa = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(site.contact.whatsappText)}`;

// Where a lost visitor most plausibly wanted to go.
const links = [
  { label: "גלריה", href: "/#gallery" },
  { label: "חבילות ומחירים", href: "/#finder" },
  { label: "אודות", href: "/#about" },
  { label: "בלוג", href: "/blog/" },
  { label: "צור קשר", href: "/#finder" },
];
---

<!doctype html>
<html lang={site.lang} dir={site.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#453226" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* An error page must never be indexed, and carries no canonical of its own. */}
    <meta name="robots" content="noindex, follow" />

    <link rel="preload" as="image" type="image/webp" imagesrcset={srcset(bg, "webp")} imagesizes="100vw" fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/FrankRuhlLibre-SemiBold.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Assistant-Regular.woff2" crossorigin />

    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#nf">דילוג לתוכן</a>

    <header class="nf-topbar">
      <a class="nf-topbar__brand" href="/" aria-label={site.brand}>
        <img src="/logo/logo-white.png" alt={site.brand} width="180" height="52" />
      </a>
      <nav class="nf-topbar__nav" aria-label="ניווט">
        <a href="/">בית</a>
        <a href="/blog/">בלוג</a>
        <a
          class="btn nf-topbar__cta"
          href="/#finder"
          data-track="cta"
          data-track-loc="404-header"
          data-track-label="availability"
        >בדיקת זמינות</a>
      </nav>
    </header>

    <main class="nf" id="nf">
      <div class="nf__media">
        <picture>
          <source type="image/webp" srcset={srcset(bg, "webp")} sizes="100vw" />
          <source type="image/jpeg" srcset={srcset(bg, "jpg")} sizes="100vw" />
          <img
            src={fallbackSrc(bg, "jpg")}
            alt=""
            width={bg.width}
            height={bg.height}
            fetchpriority="high"
            decoding="async"
            style={`background-image:url('${bg.lqip}')`}
          />
        </picture>
        <div class="nf__scrim"></div>
      </div>

      <div class="nf__inner container">
        <p class="nf__code" aria-hidden="true">404</p>
        <h1 class="nf__title">
          <span class="nf__line" style="--i:0">הרגע הזה</span>
          <span class="nf__line" style="--i:1">לא נתפס</span>
        </h1>
        <p class="nf__text">
          הדף שחיפשתם לא קיים, או שהכתובת שלו השתנתה. אל דאגה, כל השאר נמצא כאן,
          במרחק לחיצה.
        </p>

        <div class="nf__actions">
          <a
            class="btn btn--light"
            href="/"
            data-track="cta"
            data-track-loc="404"
            data-track-label="home"
          >חזרה לעמוד הבית</a>
          <a
            class="btn btn--outline-light"
            href="/#gallery"
            data-track="cta"
            data-track-loc="404"
            data-track-label="gallery"
          >לגלריית החתונות</a>
        </div>

        <a
          class="nf__wa"
          href={wa}
          target="_blank"
          rel="noopener"
          data-track="contact"
          data-track-method="whatsapp"
          data-track-loc="404"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.5 9.5 0 01-4.84-1.33l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 01-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.43 9.43 0 012.78 6.72c0 5.24-4.26 9.5-9.5 9.5zm5.53-15.01A11.42 11.42 0 0012.03.5C5.74.5.62 5.62.62 11.9c0 2.09.55 4.13 1.6 5.92L.5 23.5l5.82-1.53a11.36 11.36 0 005.71 1.46h.01c6.28 0 11.4-5.12 11.4-11.4 0-3.05-1.19-5.91-3.35-8.06z"></path>
          </svg>
          <span>{site.hero.ctaWhatsapp}</span>
        </a>

        <nav class="nf__links" aria-label="קישורים מהירים">
          {links.map((l) => (
            <a
              class="nf__link"
              href={l.href}
              data-track="cta"
              data-track-loc="404-links"
              data-track-label={l.href}
            >{l.label}</a>
          ))}
        </nav>
      </div>
    </main>

    <style>
      .skip-link {
        position: absolute;
        inset-inline-start: -9999px;
        top: 0;
        z-index: 999;
        background: var(--espresso);
        color: #fff;
        padding: 0.8rem 1.2rem;
        border-radius: 0 0 4px 0;
      }
      .skip-link:focus { inset-inline-start: 0; }

      /* Topbar floats over the photo, so it is light-on-dark throughout. */
      .nf-topbar {
        position: absolute;
        inset-block-start: 0;
        inset-inline: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem var(--gutter);
      }
      .nf-topbar__brand img { height: 38px; width: auto; display: block; }
      .nf-topbar__nav {
        display: flex;
        align-items: center;
        gap: clamp(0.9rem, 2vw, 1.8rem);
        font-family: var(--font-label);
        font-weight: 600;
        font-size: 0.88rem;
      }
      .nf-topbar__nav a:not(.btn) { color: #fff; }
      .nf-topbar__nav a:not(.btn):hover { opacity: 0.75; }
      .nf-topbar__cta {
        --btn-fg: var(--espresso);
        --btn-bg: #fff;
        border-color: #fff;
        padding: 0.6rem 1.15rem;
        font-size: 0.75rem;
      }
      @media (max-width: 560px) {
        .nf-topbar__nav a:not(.btn) { display: none; }
      }

      .nf {
        position: relative;
        isolation: isolate;
        min-height: 100svh;
        display: flex;
        align-items: center;
        padding-block: 7rem clamp(3rem, 2rem + 5vw, 6rem);
        color: #fff;
        overflow: hidden;
        background: var(--espresso);
      }
      .nf__media {
        position: absolute;
        inset: 0;
        z-index: -1;
      }
      .nf__media picture,
      .nf__media img { display: block; width: 100%; height: 100%; }
      .nf__media img {
        object-fit: cover;
        object-position: center 40%;
        background-size: cover;
        background-position: center;
        animation: nfZoom 16s var(--ease) forwards;
      }
      @keyframes nfZoom {
        from { transform: scale(1.07); }
        to { transform: scale(1); }
      }
      .nf__scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          rgba(40, 28, 20, 0.8) 0%,
          rgba(40, 28, 20, 0.52) 45%,
          rgba(40, 28, 20, 0.4) 70%,
          rgba(40, 28, 20, 0.62) 100%
        );
      }

      .nf__inner { width: 100%; }
      /* Not .eyebrow: that class forces direction:ltr for Latin tracking, which
         would park the numeral at the left edge instead of at the start of the
         RTL column. Digits need no such override. */
      .nf__code {
        display: block;
        font-family: var(--font-display);
        font-size: clamp(3.4rem, 2rem + 7vw, 7rem);
        font-weight: 600;
        line-height: 1;
        letter-spacing: 0.06em;
        color: rgba(255, 255, 255, 0.34);
        margin-block-end: clamp(0.6rem, 0.3rem + 1vw, 1.1rem);
      }
      .nf__title {
        font-family: var(--font-head);
        font-weight: 600;
        font-size: var(--fs-h1);
        line-height: 0.98;
        letter-spacing: -0.015em;
        color: #fff;
        text-shadow: 0 2px 30px rgba(30, 20, 14, 0.35);
      }
      .nf__line {
        display: block;
        opacity: 0;
        transform: translateY(30px);
        animation: nfLine 0.9s var(--ease) forwards;
        animation-delay: calc(0.1s + var(--i) * 0.1s);
      }
      @keyframes nfLine {
        to { opacity: 1; transform: none; }
      }
      .nf__text {
        margin-block-start: 1.3rem;
        max-width: 46ch;
        font-size: var(--fs-lead);
        font-weight: 300;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.92);
      }
      .nf__actions {
        margin-block-start: 1.9rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
      }
      @media (max-width: 560px) {
        .nf__actions .btn { flex: 1 1 100%; }
      }

      .nf__wa {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-block-start: 1.3rem;
        color: rgba(255, 255, 255, 0.92);
        font-weight: 600;
        font-size: 0.98rem;
        text-decoration: underline;
        text-underline-offset: 0.35em;
        text-decoration-thickness: 1px;
        text-decoration-color: rgba(255, 255, 255, 0.45);
        transition: text-decoration-color 0.3s var(--ease), color 0.3s var(--ease);
      }
      .nf__wa:hover { color: #fff; text-decoration-color: #fff; }
      .nf__wa svg { flex: none; }

      .nf__links {
        margin-block-start: clamp(2.2rem, 1.6rem + 2vw, 3.2rem);
        padding-block-start: clamp(1.2rem, 1rem + 1vw, 1.8rem);
        border-block-start: 1px solid rgba(255, 255, 255, 0.22);
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem clamp(1.1rem, 0.6rem + 1.6vw, 2.2rem);
      }
      .nf__link {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.82);
        position: relative;
        padding-block: 0.2rem;
        transition: color 0.3s var(--ease);
      }
      .nf__link::after {
        content: "";
        position: absolute;
        inset-block-end: 0;
        inset-inline-end: 0;
        width: 0;
        height: 1.5px;
        background: currentColor;
        transition: width 0.4s var(--ease);
      }
      .nf__link:hover { color: #fff; }
      .nf__link:hover::after { width: 100%; }

      @media (prefers-reduced-motion: reduce) {
        .nf__media img { animation: none; }
        .nf__line { animation: none; opacity: 1; transform: none; }
      }
    </style>

    <script>
      import "@/scripts/track.js";
    </script>

    <script is:inline>
      // Which URLs are actually 404ing, and where visitors arrived from. GA4's
      // page_view alone can't tell a 404 apart from any other page, so report
      // the dead path explicitly (lpTrackCustom is a safe no-op when analytics
      // are off, e.g. on localhost).
      window.lpTrackCustom?.("page_not_found", {
        path: location.pathname + location.search,
        referrer: document.referrer || "(none)",
      });
    </script>
  </body>
</html>
