---
import { getCollection } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import Picture from "@/components/Picture.astro";
import Footer from "@/components/Footer.astro";
import manifest from "@/data/gallery.generated.json";
import site from "@/data/site.js";
import { resolveItem } from "@/lib/images.js";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;

const cover = resolveItem(manifest, d.coverId);
const wa = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(site.contact.whatsappText)}`;
const dateLabel = d.publishDate.toLocaleDateString("he-IL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BlogLayout
  title={d.seoTitle ?? d.title}
  description={d.seoDescription ?? d.excerpt}
  coverId={d.coverId}
  article={{ publishDate: d.publishDate, updatedDate: d.updatedDate }}
>
  <article class="post" id="article">
    <header class="post__head container">
      <nav class="post__crumbs" aria-label="נתיב ניווט">
        <a href="/">בית</a><span aria-hidden="true">·</span><a href="/blog/">בלוג</a>
      </nav>
      <h1 class="post__title">{d.title}</h1>
      <p class="post__excerpt">{d.excerpt}</p>
      <p class="post__meta">
        <time datetime={d.publishDate.toISOString()}>{dateLabel}</time>
        <span aria-hidden="true">·</span>
        <span>{d.readingMinutes} דקות קריאה</span>
      </p>
    </header>

    <figure class="post__cover">
      <Picture
        item={cover}
        alt={`${d.title} - ${site.brand}`}
        sizes="(max-width: 1100px) 100vw, 1100px"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <div class="post__body container">
      <Content />
    </div>

    <aside class="post__cta">
      <div class="container post__cta-inner">
        <p class="eyebrow">BROTHERS.</p>
        <h2>מתכננים חתונה? בואו נדבר</h2>
        <p>
          תיעוד טבעי וקולנועי, בכל הארץ, בלי תוספת נסיעה. ספרו לי על האירוע שלכם
          ואחזור אליכם עם הצעה מותאמת.
        </p>
        <div class="post__cta-actions">
          <a class="btn" href="/#contact">לתיאום פגישה</a>
          <a class="btn btn--ghost" href={wa}>דברו איתי בוואטסאפ</a>
        </div>
      </div>
    </aside>
  </article>

  <Footer nav={false} />
</BlogLayout>

<style>
  .post { background: var(--paper); }

  .post__head {
    max-width: 780px;
    text-align: center;
    padding-block: clamp(2.4rem, 1.6rem + 3vw, 4.5rem) clamp(1.6rem, 1rem + 2vw, 2.6rem);
  }
  .post__crumbs {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    font-family: var(--font-label);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-45);
    margin-block-end: 1.2rem;
  }
  .post__crumbs a { color: var(--ink-45); }
  .post__crumbs a:hover { color: var(--chestnut); }

  .post__title {
    font-size: var(--fs-h2);
    line-height: 1.18;
    margin-block-end: 1rem;
  }
  .post__excerpt {
    font-size: var(--fs-lead);
    font-weight: 300;
    color: var(--ink-60);
    line-height: 1.6;
  }
  .post__meta {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-block-start: 1.4rem;
    font-family: var(--font-label);
    font-size: 0.82rem;
    color: var(--ink-45);
  }

  .post__cover {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  /* Cap the hero crop so a portrait cover can't push the article below the
     fold; Picture's own aspect-ratio would otherwise run 2:3. */
  .post__cover :global(.pic) {
    aspect-ratio: 16 / 9;
    border-radius: 6px;
  }
  @media (max-width: 640px) {
    .post__cover :global(.pic) { aspect-ratio: 4 / 3; }
  }

  /* ---- Prose ---- */
  .post__body {
    max-width: 720px;
    padding-block: clamp(2.2rem, 1.6rem + 2.6vw, 3.6rem);
    font-size: var(--fs-body);
    line-height: 1.85;
    color: var(--ink);
    font-weight: 300;
  }
  .post__body :global(h2) {
    font-size: var(--fs-h3);
    line-height: 1.3;
    margin-block: 2.4em 0.8em;
  }
  .post__body :global(h3) {
    font-family: var(--font-head);
    font-size: 1.15rem;
    font-weight: 600;
    margin-block: 1.8em 0.6em;
    color: var(--chestnut);
  }
  .post__body :global(p) { margin-block-end: 1.15em; }
  .post__body :global(strong) { font-weight: 600; color: var(--espresso); }
  .post__body :global(ul),
  .post__body :global(ol) {
    margin-block-end: 1.4em;
    padding-inline-start: 1.3em;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }
  .post__body :global(ul) { list-style: disc; }
  .post__body :global(ol) { list-style: decimal; }
  .post__body :global(li) { padding-inline-start: 0.2em; }
  .post__body :global(li::marker) { color: var(--chestnut); }
  .post__body :global(hr) {
    border: 0;
    border-block-start: 1px solid var(--line);
    margin-block: 2.4em;
  }
  .post__body :global(a) {
    color: var(--chestnut);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- Closing CTA ---- */
  .post__cta {
    background: var(--cream);
    border-block-start: 1px solid var(--line-soft);
    padding-block: clamp(2.6rem, 2rem + 3vw, 4.5rem);
    text-align: center;
  }
  .post__cta-inner { max-width: 640px; }
  .post__cta .eyebrow { margin-block-end: 0.8rem; }
  .post__cta h2 {
    font-size: var(--fs-h3);
    margin-block-end: 0.8rem;
  }
  .post__cta p {
    color: var(--ink-60);
    font-weight: 300;
    line-height: 1.7;
  }
  .post__cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-block-start: 1.8rem;
  }
</style>
